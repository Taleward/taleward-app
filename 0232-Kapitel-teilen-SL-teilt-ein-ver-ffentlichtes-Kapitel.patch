+++ b/src/share/ShareChapter.tsx
@@ -0,0 +1,53 @@
+import { useState } from 'react';
+import { api } from '../api/client';
+import { currentConnection } from '../api/connections';
+import type { Campaign } from '../api/types';
+import { saveOrShare } from '../characters/backup';
+import { ErrorBox } from '../components/Screen';
+import { t } from '../i18n';
+
+/** Kann dieser Server Kapitel als Datei teilen? (Schnittstelle 0.4.30, Signierschlüssel bekannt) */
+export function serverCanShare(): boolean {
+  try { return !!currentConnection().shareKeys?.length; } catch { return false; }
+}
+
+/**
+ * „Kapitel teilen“ (nur SL, veröffentlichtes Kapitel): Datei vom Server holen und über das Teilen-Menü weitergeben –
+ * für Gruppen, deren Server nur im Heimnetz läuft. Die Datei öffnet nur, wer Mitglied der Kampagne ist.
+ */
+export function ShareChapter({ campaign, sessionId }: { campaign: Campaign; sessionId: string }) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<unknown>(null);
+  const [missing, setMissing] = useState<string | null>(null);
+
+  const share = async () => {
+    setBusy(true);
+    setError(null);
+    setMissing(null);
+    try {
+      const r = await api.shareChapter(campaign.id, sessionId);
+      const names = r.missingKeys
+        .map((id) => campaign.members.find((m) => m.id === id))
+        .map((m) => m?.characterName || m?.displayName)
+        .filter((x): x is string => !!x);
+      if (names.length) setMissing(t('Für {names} geht es erst nach dem nächsten Treffen im WLAN.', { names: names.join(', ') }));
+      const safeName = /^[A-Za-z0-9._-]{1,80}$/.test(r.fileName) ? r.fileName : 'taleward-kapitel.taleward';
+      await saveOrShare(new File([r.file], safeName, { type: 'application/vnd.taleward.share+json' }), t('Kapitel teilen'));
+    } catch (e) {
+      setError(e);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      <ErrorBox error={error} />
+      <button type="button" className="quiet-link" disabled={busy} onClick={share}>{t('Kapitel als Datei teilen')}</button>
+      <p className="muted small" style={{ margin: '-6px 0 0' }}>
+        {t('Für den Gruppenchat, wenn euer Server nur im Heimnetz läuft. Öffnen kann die Datei nur, wer in der Kampagne ist.')}
+      </p>
+      {missing && <div className="notice" role="status">{missing}</div>}
+    </>
+  );
+}
diff --git a/src/share/importShare.ts b/src/share/importShare.ts
new file mode 100644
index 0000000..c90edd7
--- /dev/null
+++ b/src/share/importShare.ts
@@ -0,0 +1,78 @@
+/*
+ * Geteiltes Kapitel öffnen (Schnittstelle 0.4.30): Datei prüfen (shareFile.ts) und den Inhalt in die Lesekopie der
+ * passenden Verbindung legen – durch dieselbe Positivliste wie Antworten des Servers. Neueres gewinnt; die nächste
+ * Antwort des Servers ersetzt die Kopie ohnehin.
+ */
+import { listConnections, type Connection } from '../api/connections';
+import { readCopy, saveCopy } from '../api/readCopy';
+import { cleanForCopy } from '../api/readCopyRules';
+import { openShareFile, SHARE_MAX_FILE, ShareRejected, type ShareMemberKey } from './shareFile';
+
+type Obj = Record<string, unknown>;
+const isObj = (x: unknown): x is Obj => typeof x === 'object' && x !== null && !Array.isArray(x);
+
+/** Angemeldete Verbindungen zu diesem Server (Schlüssel und Kopie gehören zu Verbindung und Konto) */
+const signedIn = (serverId: string) => listConnections().filter((c) => c.serverId === serverId && !!c.token && !!c.user);
+
+export interface OpenedShare { conn: Connection; campaignId: string; campaignTitle: string; sessionId: string | null; sessionNumber: number | null; createdAt: string }
+
+export async function importShareFile(file: File): Promise<OpenedShare> {
+  if (file.size > SHARE_MAX_FILE) throw new ShareRejected();
+  let target: Connection | null = null;
+  const { head, content } = await openShareFile(await file.text(), {
+    serverKeys: (serverId) => signedIn(serverId).flatMap((c) => c.shareKeys ?? []),
+    memberKey: async (serverId, campaignId) => {
+      for (const c of signedIn(serverId)) {
+        const copy = await readCopy(c.id, c.user!.id, `/campaigns/${campaignId}`).catch(() => null);
+        const key = isObj(copy?.data) && isObj(copy.data.shareKey) ? copy.data.shareKey as unknown as ShareMemberKey : null;
+        if (key) { target = c; return key; }
+      }
+      return null;
+    }
+  });
+  const conn = target as Connection | null;
+  if (!conn?.user) throw new ShareRejected();
+  const userId = conn.user.id;
+  const { campaignId, createdAt } = head;
+
+  // Nur überschreiben, was älter ist als die Datei
+  const put = async (path: string, data: unknown) => {
+    const clean = cleanForCopy(path, data, userId);
+    if (clean === null) return;
+    const old = await readCopy(conn.id, userId, path).catch(() => null);
+    if (old && old.savedAt >= createdAt) return;
+    await saveCopy(conn.id, userId, path, clean, campaignId, () => true, createdAt);
+  };
+
+  let first: { id: string; number: number } | null = null;
+  for (const item of (content.sessions as unknown[]).slice(0, 1)) {
+    if (!isObj(item) || !isObj(item.session) || !isObj(item.recap)) continue;
+    const s = item.session, r = item.recap;
+    if (typeof s.id !== 'string' || !/^[A-Za-z0-9_-]{1,64}$/.test(s.id) || r.sessionId !== s.id || !r.publishedAt) continue;
+    await put(`/sessions/${s.id}`, { ...s, campaignId, publishedAt: r.publishedAt, state: 'published' });
+    await put(`/sessions/${s.id}/recap`, r);
+    // Kapitelliste: zusammenführen, das geteilte Kapitel ersetzt nur sich selbst
+    const listPath = `/campaigns/${campaignId}/sessions`;
+    const list = await readCopy(conn.id, userId, listPath).catch(() => null);
+    const old = Array.isArray(list?.data) ? (list.data as Obj[]).filter((x) => x.id !== s.id) : [];
+    const merged = [...old, { ...s, state: 'published' }].sort((a, b) => Number(a.number) - Number(b.number));
+    const clean = cleanForCopy(listPath, merged, userId);
+    if (clean) await saveCopy(conn.id, userId, listPath, clean, campaignId, () => true, list?.savedAt && list.savedAt > createdAt ? list.savedAt : createdAt);
+    if (typeof s.number === 'number') first = { id: s.id, number: s.number };
+  }
+
+  // Einträge: nach id zusammenführen, höheres updatedAt gewinnt
+  const entriesPath = `/campaigns/${campaignId}/entries`;
+  const have = await readCopy(conn.id, userId, entriesPath).catch(() => null);
+  const byId = new Map<string, Obj>((Array.isArray(have?.data) ? have.data as Obj[] : []).map((e) => [String(e.id), e]));
+  for (const e of content.entries as unknown[]) {
+    if (!isObj(e) || typeof e.id !== 'string' || e.campaignId !== campaignId) continue;
+    const old = byId.get(e.id);
+    if (!old || String(e.updatedAt ?? '') > String(old.updatedAt ?? '')) byId.set(e.id, e);
+  }
+  const cleanEntries = cleanForCopy(entriesPath, [...byId.values()], userId);
+  if (cleanEntries) await saveCopy(conn.id, userId, entriesPath, cleanEntries, campaignId, () => true, have?.savedAt && have.savedAt > createdAt ? have.savedAt : createdAt);
+
+  return { conn, campaignId, campaignTitle: String(content.campaignTitle).slice(0, 200), sessionId: (first as { id: string } | null)?.id ?? null,
+    sessionNumber: (first as { number: number } | null)?.number ?? null, createdAt };
+}
diff --git a/src/share/keys.ts b/src/share/keys.ts
new file mode 100644
index 0000000..07efc94
--- /dev/null
+++ b/src/share/keys.ts
@@ -0,0 +1,10 @@
+/** Signierschlüssel aus /info säubern (ab 0.4.30): höchstens 4, Kennung und SPKI nur base64url. Ohne Laufzeit-Importe. */
+export function cleanShareKeys(keys: unknown): { id: string; spki: string }[] {
+  if (!Array.isArray(keys)) return [];
+  return keys
+    .filter((k): k is { id: string; spki: string } => typeof k === 'object' && k !== null
+      && typeof (k as { id?: unknown }).id === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test((k as { id: string }).id)
+      && typeof (k as { spki?: unknown }).spki === 'string' && /^[A-Za-z0-9_-]{40,400}$/.test((k as { spki: string }).spki))
+    .slice(0, 4)
+    .map((k) => ({ id: k.id, spki: k.spki }));
+}
diff --git a/src/share/shareFile.ts b/src/share/shareFile.ts
new file mode 100644
index 0000000..6a21a1e
--- /dev/null
+++ b/src/share/shareFile.ts
@@ -0,0 +1,112 @@
+/*
+ * „Kapitel teilen“ (Schnittstelle 0.4.30): geteilte Datei prüfen und öffnen. Nur WebCrypto und Kompression des
+ * Browsers, ohne Laufzeit-Importe (Test mit dem gemeinsamen Testvektor: scripts/tests/share-file.test.mjs).
+ *
+ * Reihenfolge nach S45: Größe → format → Signatur gegen einen gespeicherten Schlüssel genau dieser serverId (nie aus
+ * der Datei) → Verbindung und Mitgliedschaft → entschlüsseln (höchstens 20 MB entpackt) → Schema. Jeder Fehlschlag
+ * ist derselbe Fehler (ShareRejected), damit niemand am Text sieht, woran es lag.
+ */
+
+export const SHARE_FORMAT = 'taleward-kapitel/1';
+export const SHARE_MAX_FILE = 5 * 1024 * 1024;
+export const SHARE_MAX_CONTENT = 20 * 1024 * 1024;
+
+export class ShareRejected extends Error {
+  constructor() { super('share_rejected'); }
+}
+
+export interface ShareServerKey { id: string; spki: string }
+export interface ShareMemberKey { id: string; key: string }
+
+export interface ShareHead { serverId: string; campaignId: string; shareId: string; createdAt: string }
+
+export interface ShareLookup {
+  /** Gespeicherte Signierschlüssel des Servers (nur aus angemeldeten Verbindungen), leer = unbekannter Server */
+  serverKeys(serverId: string): ShareServerKey[];
+  /** Eigener Schlüssel in dieser Kampagne auf diesem Server, oder null (kein Mitglied, keine Verbindung) */
+  memberKey(serverId: string, campaignId: string): Promise<ShareMemberKey | null>;
+}
+
+type Obj = Record<string, unknown>;
+const isObj = (x: unknown): x is Obj => typeof x === 'object' && x !== null && !Array.isArray(x);
+const isStr = (x: unknown): x is string => typeof x === 'string';
+const ID = /^[A-Za-z0-9_-]{1,64}$/;
+
+export function fromB64url(s: string): Uint8Array<ArrayBuffer> {
+  if (!/^[A-Za-z0-9_-]*$/.test(s)) throw new ShareRejected();
+  const b64 = s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+const utf8 = (s: string) => new TextEncoder().encode(s);
+const concat = (a: Uint8Array, b: Uint8Array) => { const o = new Uint8Array(a.length + b.length); o.set(a); o.set(b, a.length); return o; };
+
+/** Kopf (AAD) in genau dieser Reihenfolge, ohne Leerzeichen */
+export function shareHeader(h: ShareHead): Uint8Array<ArrayBuffer> {
+  return utf8(JSON.stringify({ format: SHARE_FORMAT, serverId: h.serverId, campaignId: h.campaignId, shareId: h.shareId, createdAt: h.createdAt }));
+}
+
+async function gunzipLimited(data: Uint8Array<ArrayBuffer>, limit: number): Promise<Uint8Array<ArrayBuffer>> {
+  const stream = new Blob([data]).stream().pipeThrough(new DecompressionStream('gzip'));
+  const reader = stream.getReader();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    size += value.length;
+    if (size > limit) { await reader.cancel(); throw new ShareRejected(); }
+    chunks.push(value);
+  }
+  const out = new Uint8Array(size);
+  let at = 0;
+  for (const c of chunks) { out.set(c, at); at += c.length; }
+  return out;
+}
+
+/**
+ * Prüft und entschlüsselt eine geteilte Datei. Liefert Kopf und Inhalt (noch ungeprüft gegen die Positivliste der
+ * Lesekopie – das macht der Aufrufer) oder wirft ShareRejected.
+ */
+export async function openShareFile(text: string, lookup: ShareLookup): Promise<{ head: ShareHead; content: Obj }> {
+  try {
+    if (text.length > SHARE_MAX_FILE) throw new ShareRejected();
+    const file = JSON.parse(text) as unknown;
+    if (!isObj(file) || file.format !== SHARE_FORMAT || !isStr(file.signed) || !isStr(file.signature)) throw new ShareRejected();
+    const signedBytes = fromB64url(file.signed);
+    const signed = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(signedBytes)) as unknown;
+    if (!isObj(signed) || !isStr(signed.serverId) || !isStr(signed.signKeyId)) throw new ShareRejected();
+    // Signatur zuerst: Schlüssel nur aus einer angemeldeten Verbindung zu genau diesem Server
+    const serverKey = lookup.serverKeys(signed.serverId).find((k) => k.id === signed.signKeyId);
+    if (!serverKey) throw new ShareRejected();
+    const pub = await crypto.subtle.importKey('spki', fromB64url(serverKey.spki), { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+    const sig = fromB64url(file.signature);
+    if (sig.length !== 64) throw new ShareRejected();
+    if (!(await crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, pub, sig, signedBytes))) throw new ShareRejected();
+
+    const { serverId, campaignId, shareId, createdAt, recipients, nonce, ciphertext } = signed;
+    if (!isStr(campaignId) || !ID.test(campaignId) || !isStr(shareId) || !isStr(createdAt) || Number.isNaN(Date.parse(createdAt))
+      || !Array.isArray(recipients) || !isStr(nonce) || !isStr(ciphertext)) throw new ShareRejected();
+    const head: ShareHead = { serverId, campaignId, shareId, createdAt };
+    const mine = await lookup.memberKey(serverId, campaignId);
+    if (!mine) throw new ShareRejected();
+    const r = recipients.find((x): x is Obj => isObj(x) && x.keyId === mine.id);
+    if (!r || !isStr(r.nonce) || !isStr(r.wrapped)) throw new ShareRejected();
+    const header = shareHeader(head);
+    const memberKey = await crypto.subtle.importKey('raw', fromB64url(mine.key), 'AES-GCM', false, ['decrypt']);
+    const contentKeyRaw = new Uint8Array(await crypto.subtle.decrypt(
+      { name: 'AES-GCM', iv: fromB64url(r.nonce), additionalData: concat(header, utf8(mine.id)) }, memberKey, fromB64url(r.wrapped)));
+    if (contentKeyRaw.length !== 32) throw new ShareRejected();
+    const contentKey = await crypto.subtle.importKey('raw', contentKeyRaw, 'AES-GCM', false, ['decrypt']);
+    const packed = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: fromB64url(nonce), additionalData: header }, contentKey, fromB64url(ciphertext)));
+    const raw = await gunzipLimited(packed, SHARE_MAX_CONTENT);
