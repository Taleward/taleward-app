From 9df0cfa22f66850893776b0f6536641efcab70cb Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:13:02 +0100
Subject: [PATCH] Schnittstelle 0.4.23: Registrierungsarten und SL-Freigabe

---
 docs/session-chronik-api.yaml | 108 +++++++++++++++++++++++++++++++---
 1 file changed, 99 insertions(+), 9 deletions(-)

diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index 4bc835c..b6a8992 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -2,5 +2,5 @@ openapi: 3.1.0
 info:
   title: Taleward API
-  version: 0.4.22
+  version: 0.4.23
   description: |
     Schnittstelle zwischen der Taleward-App (Android, Web) und dem Taleward-Server.
@@ -227,4 +227,13 @@ info:
     Präzisiert in 0.4.22 (nur Text, keine neue Fassungsnummer): Aufbewahrung der Hörproben einheitlich bei
     ServerInfo.audioRetention beschrieben.
+    Änderungen in 0.4.23 (Registrierungsarten und SL-Freigabe): ServerInfo.registration kennt zusätzlich `code`
+    (allgemeiner Registrierungscode des Betreibers, Konto ohne Kampagne) und `open` (Konto ohne Code). Kampagnen-
+    einladungen gehen weiter in allen Arten außer `closed`. Registrierungscode und offene Registrierung geben weder
+    Mitgliedschaft noch SL-Recht. ServerInfo.gmApproval sagt, ob eigene Kampagnen eine SL-Freigabe brauchen;
+    User.gmPermission den Stand des eigenen Kontos. POST /me/gm-request stellt die Anfrage (bestätigte E-Mail nötig),
+    die Verwaltung entscheidet per Mail-Link nach Anmeldung. Ohne Freigabe → 403 `gm_permission_required` bei
+    POST /campaigns und POST /imports. Bestehende Konten, die schon SL einer Kampagne sind oder ein Verwaltungskonto
+    haben, bekommen beim Update `granted`, alle anderen `none`. Ältere Apps behandeln unbekannte registration-Werte
+    wie invite_only und sehen bei fehlender Freigabe den Fehler beim Anlegen.
 
 servers:
@@ -305,8 +314,15 @@ paths:
     post:
       tags: [Auth]
-      summary: Konto mit Einladungscode anlegen
+      summary: Konto anlegen (mit Einladung, Registrierungscode oder offen)
       description: |
-        Nur mit gültigem Einladungscode (registration invite_only; 404 `invite_invalid`), sonst 403 `registration_closed`.
-        Legt nur das Konto an – den Beitritt zur Kampagne macht die App danach mit POST /campaigns/join.
+        Nach ServerInfo.registration:
+        - invite_only: inviteCode Pflicht (unbekannt, abgelaufen oder aufgebraucht → 404 `invite_invalid`).
+        - code (ab 0.4.23): inviteCode oder registrationCode. Falscher registrationCode → 400 `registration_code_invalid`;
+          fehlt beides → 400 `registration_code_required`.
+        - open (ab 0.4.23): kein Code nötig; ein inviteCode wird wie oben geprüft.
+        - closed: 403 `registration_closed`.
+        Legt nur das Konto an – den Beitritt zur Kampagne macht die App danach mit POST /campaigns/join (nur, wenn sie
+        mit inviteCode registriert hat). Der registrationCode tritt nichts bei und gibt kein SL-Recht; ein neues Konto
+        hat gmPermission none.
         acceptPrivacy und ageConfirmed müssen true sein (400 `consent_required`); beides mit Zeitpunkt protokollieren.
         Ab 0.4.22 zusätzlich acceptTerms true und termsVersion = ServerInfo.termsVersion (fehlt eins → 400
@@ -324,7 +340,8 @@ paths:
                 - type: object
                   title: Mit Benutzername und Passwort
-                  required: [inviteCode, username, displayName, password, acceptPrivacy, ageConfirmed]
+                  required: [username, displayName, password, acceptPrivacy, ageConfirmed]
                   properties:
-                    inviteCode: { type: string }
+                    inviteCode: { type: string, description: "Kampagneneinladung; Pflicht bei invite_only (vor 0.4.23 immer)" }
+                    registrationCode: { type: string, description: "Ab 0.4.23, nur bei registration code: allgemeiner Code des Betreibers" }
                     username: { type: string, description: "3–64 Zeichen aus Buchstaben, Ziffern, . - _ (400 username_invalid); wird kleingeschrieben" }
                     displayName: { type: string }
@@ -339,8 +356,9 @@ paths:
                     registrationToken aus POST /auth/oidc/exchange (status register, 15 min gültig). Benutzername bildet der
                     Server (eindeutig, später änderbar), kein Passwort. Die bestätigte E-Mail des Dienstes wird übernommen.
-                    Einladungspflicht wie oben. 400 registration_token_invalid.
-                  required: [inviteCode, registrationToken, displayName, acceptPrivacy, ageConfirmed]
+                    Code-Regeln wie oben. 400 registration_token_invalid.
+                  required: [registrationToken, displayName, acceptPrivacy, ageConfirmed]
                   properties:
                     inviteCode: { type: string }
+                    registrationCode: { type: string, description: "Ab 0.4.23, wie oben" }
                     registrationToken: { type: string }
                     displayName: { type: string }
@@ -495,4 +513,39 @@ paths:
         "409": { $ref: "#/components/responses/Conflict" }
 
+  /me/gm-request:
+    post:
+      tags: [Auth]
+      summary: SL-Freigabe anfragen (ab 0.4.23)
+      description: |
+        Nur sinnvoll bei ServerInfo.gmApproval required. Legt eine Anfrage an und schickt eine Mail an die Verwaltung
+        des Servers; die Mail enthält einen Link zur Entscheidung, der selbst nichts vergibt (entschieden wird nach
+        Anmeldung in der Verwaltung). Die Entscheidung geht per Mail an die Person, der Stand steht in
+        User.gmPermission (GET /me).
+        - none → 202, gmPermission pending.
+        - pending → 202, nichts ändert sich, keine zweite Mail.
+        - granted → 200, nichts ändert sich.
+        - rejected → 409 `gm_request_closed`. Eine neue Anfrage geht erst, wenn die Verwaltung sie wieder erlaubt
+          (dann steht gmPermission wieder auf none).
+        Voraussetzung: bestätigte E-Mail (User.email); sonst 409 `email_unverified`. Kann der Server die Mail gerade
+        nicht schicken, bleibt die Anfrage trotzdem gespeichert (202, pending); die Verwaltung sieht sie mit Hinweis.
+        Bei gmApproval none → 200 mit dem aktuellen Stand, nichts wird angelegt.
+        Kein Text, keine Begründung von der Person: die Verwaltung sieht Anzeigename, Benutzername und Datum.
+      responses:
+        "200":
+          description: Nichts zu tun (schon freigegeben oder keine Freigabe nötig)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/User" }
+        "202":
+          description: Anfrage liegt vor (pending)
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/User" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "409": { $ref: "#/components/responses/Conflict" }
+        "429":
+          description: Zu viele Versuche
+          content: { application/json: { schema: { $ref: "#/components/schemas/Error" } } }
+
   /me/email:
     put:
@@ -723,4 +776,7 @@ paths:
       tags: [Kampagnen]
       summary: Neue Kampagne anlegen (Ersteller wird SL)
+      description: |
+        Ab 0.4.23: Bei ServerInfo.gmApproval required nur mit User.gmPermission granted, sonst 403
+        `gm_permission_required` (nichts wird angelegt). Die App fragt vorher und bietet stattdessen die Anfrage an.
       requestBody:
         required: true
@@ -748,4 +804,5 @@ paths:
         "400": { $ref: "#/components/responses/BadRequest" }
         "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
 
   /campaigns/join:
@@ -1295,4 +1352,6 @@ paths:
         Stückweiser Upload wie bei Aufnahmen. Größte Datei stellt der Betreiber ein (Standard 1 GB). Nicht
         abgeschlossene Importe löscht der Server nach 7 Tagen.
+        Ab 0.4.23: Die importierende Person wird SL einer neuen Kampagne, daher gilt dieselbe Regel wie bei
+        POST /campaigns (403 `gm_permission_required`). Der Server prüft beim Beginn und noch einmal bei …/complete.
       requestBody:
         required: true
@@ -1319,4 +1378,5 @@ paths:
         "400": { $ref: "#/components/responses/BadRequest" }
         "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
         "413":
           description: Datei zu groß (`import_too_large`, details.maxBytes)
@@ -1383,4 +1443,5 @@ paths:
               schema: { $ref: "#/components/schemas/ImportStatus" }
         "401": { $ref: "#/components/responses/Unauthorized" }
+        "403": { $ref: "#/components/responses/Forbidden" }
         "404": { $ref: "#/components/responses/NotFound" }
         "409":
@@ -3124,5 +3185,24 @@ components:
         contact: { type: [string, "null"] }
         apiVersion: { type: string, example: "0.3.8" }
-        registration: { type: string, enum: [invite_only, closed] }
+        registration:
+          type: string
+          enum: [invite_only, code, open, closed]
+          description: |
+            Wie man ein Konto bekommt (code und open ab 0.4.23):
+            - invite_only: nur mit einer Kampagneneinladung, die App tritt danach bei.
+            - code: mit dem allgemeinen Registrierungscode des Betreibers (steht nie hier) oder mit einer
+              Kampagneneinladung. Mit dem allgemeinen Code entsteht nur das Konto, ohne Kampagne.
+            - open: ohne Code (z. B. Community-Server); eine Kampagneneinladung geht weiter.
+            - closed: keine neuen Konten.
+            Unbekannte Werte behandelt die App wie invite_only.
+        gmApproval:
+          type: string
+          enum: [required, none]
+          description: |
+            Ab 0.4.23: required = eigene Kampagnen anlegen (POST /campaigns, POST /imports) nur mit User.gmPermission
+            granted; die App bietet sonst „SL-Freigabe anfragen“ an. none = jedes Konto darf. Fehlt das Feld (Server
+            vor 0.4.23), wie none. Welche Regel dahinter steht (Einstellung des Betreibers, Abrechnung), entscheidet
+            der Server; die App liest nur dieses Feld. SL einer bestehenden Kampagne werden (Einladung als SL,
+            Übergabe) braucht keine Freigabe.
         authMethods: { type: array, items: { type: string, enum: [password, oidc, passkey] }, description: "oidc, sobald mindestens ein Dienst eingerichtet ist" }
         privacyPolicyUrl: { type: [string, "null"] }
@@ -3450,4 +3530,14 @@ components:
             und beim Verlassen fragt sie nicht erst danach.
         termsAcceptedAt: { type: [string, "null"], format: date-time, description: "Ab 0.4.22, Zeitpunkt dieser Zustimmung" }
+        gmPermission:
+          type: string
+          enum: [granted, none, pending, rejected]
+          description: |
+            Ab 0.4.23: darf dieses Konto eigene Kampagnen anlegen? Zählt nur bei ServerInfo.gmApproval required.
+            none = nicht angefragt (oder die Verwaltung hat eine neue Anfrage wieder erlaubt), pending = wird geprüft,
+            rejected = abgelehnt (neue Anfrage erst, wenn die Verwaltung sie erlaubt), granted = freigegeben. Entzieht
+            die Verwaltung die Freigabe, steht hier wieder none bzw. rejected; bestehende Kampagnen bleiben. Fehlt das
+            Feld (Server vor 0.4.23), wie granted. Unbekannte Werte wie none.
+        gmDecidedAt: { type: [string, "null"], format: date-time, description: "Ab 0.4.23: Zeitpunkt der letzten Entscheidung (granted/rejected), sonst null" }
 
     VoiceProfile:
