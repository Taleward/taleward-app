+              properties:
+                code: { type: string, enum: [addressed_as, self_named] }
+                name: { type: string, description: "Der Figurenname, wie er in der Abschrift steht" }
+                memberId: { type: string }
+                count: { type: integer, minimum: 1 }
+            - { type: "null" }
         suggestedMemberId: { type: [string, "null"] }
         confidence: { type: number, minimum: 0, maximum: 1 }
@@ -3682,4 +3737,28 @@ components:
             Regelerklärung, Off-Topic) – der Name muss als Spielerwissen in der Szene vorkommen.
         targetEntryId: { type: [string, "null"], description: Bei update der betroffene Eintrag }
+        match:
+          description: |
+            Ab 0.4.21, nur bei action create (Session und Unterlage): Der Vorschlag klingt wie ein vorhandener Eintrag. Der
+            Server prüft ohne Sprachmodell gegen Namen und aliases aller Einträge der Kampagne (auch gm_only): Klang
+            (sound, Kölner Phonetik), Schreibweise (spelling, kleiner Zeichenabstand), Teilname (part_name, „Hauptmann
+            Varek“ gegen „Varek“). Höchstens ein Treffer, der beste. name = Name des Eintrags, matchedName = welcher Name
+            oder Alias passte. null = kein Treffer. Die App fragt dann „Klingt wie … Dort ergänzen?“.
+          oneOf:
+            - type: object
+              required: [entryId, name, entryType, kind]
+              properties:
+                entryId: { type: string }
+                name: { type: string }
+                matchedName: { type: string }
+                entryType: { $ref: "#/components/schemas/EntryType" }
+                kind: { type: string, enum: [sound, spelling, part_name] }
+            - { type: "null" }
+        mergeIntoEntryId:
+          type: [string, "null"]
+          description: |
+            Ab 0.4.21: Die SL hat entschieden, den create-Vorschlag bei diesem Eintrag zu ergänzen (PATCH). Gesetzt wirkt er
+            wie update auf diesen Eintrag (beim Veröffentlichen bzw. Übernehmen wie bei update angehängt); der Titel des
+            Vorschlags kommt zu aliases, wenn er weder Name noch Alias ist. Die Sichtbarkeit des Eintrags ändert sich
+            dadurch nicht. null = als neuer Eintrag.
         title: { type: string }
         detail: { type: string, description: "Spielerwissen (öffentlicher Teil)" }
@@ -3768,4 +3847,28 @@ components:
         publishedAt: { type: [string, "null"], format: date-time }
         review: { $ref: "#/components/schemas/RecapReview" }
+        gmWarnings:
+          type: array
+          description: |
+            Ab 0.4.21, nur SL (für Spieler weggelassen, auch keine Anzahl). Der Server prüft das Kapitel nach jedem
+            Schreiben und jeder Änderung des Textes (PUT …/recap, übernommene Korrektur, neu schreiben):
+            secret_entry_name = der Text nennt Name oder Alias eines Eintrags, den nicht alle Spieler kennen (gm_only oder
+            teilweise verborgen); secret_wording = eine längere Stelle stimmt wörtlich mit gmNotes oder dem Text eines
+            gm_only-Eintrags überein. Ein Hinweis je Code und Eintrag. Veröffentlichen bleibt möglich; die App zeigt die
+            Hinweise vor der Freigabe. Ein Eintrag, den dieses Kapitel per reveal-Vorschlag aufdecken würde, zählt nicht,
+            solange der Vorschlag angenommen ist. Leer oder fehlend = nichts gefunden.
+          items:
+            type: object
+            required: [code, entryIds]
+            properties:
+              code: { type: string, enum: [secret_entry_name, secret_wording] }
+              entryIds: { type: array, minItems: 1, items: { type: string } }
+              names:
+                type: array
+                items: { type: string }
+                description: Die gefundenen Namen bzw. Aliasse, wie sie im Kapitel stehen
+              paragraphs:
+                type: array
+                items: { type: integer, minimum: 0 }
+                description: Betroffene Absätze (0-basiert, wie RecapReview.paragraphs)
         revision:
           description: Offener Korrektur-Entwurf (ab 0.4.15, nur SL; für Spieler weggelassen). Ohne Entwurf null.
@@ -3906,4 +4009,14 @@ components:
         status: { type: [string, "null"], enum: [active, done, null], description: Nur für Quests }
         holderMemberId: { type: [string, "null"], description: Nur für Gegenstände }
+        aliases:
+          type: array
+          maxItems: 10
+          items: { type: string, minLength: 1, maxLength: 40 }
+          description: |
+            Ab 0.4.21, freiwillig („Auch genannt“): andere Namen oder Schreibweisen, unter denen der Eintrag vorkommt
+            („Tarvok“, „der Alte“). Sichtbar wie der Name: Spieler bekommen sie nur bei Einträgen, die sie sehen, und
+            die Suche der Spieler findet sie nur dort. Recap-Pipeline: nur aliases öffentlicher, nicht teilweise
+            verborgener Einträge; Vorschlags-Pipeline, Dublettenprüfung (Proposal.match) und Namenshilfe: alle. Doppelte und
+            der Name selbst fallen beim Speichern weg. Fehlt bei älteren Servern.
         visibility: { $ref: "#/components/schemas/Visibility" }
         hiddenFromMemberIds:
