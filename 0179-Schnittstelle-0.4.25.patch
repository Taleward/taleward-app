+    CreditWait:
+      type: object
+      description: |
+        Ab 0.4.25. Warum ein Auftrag (Abschrift, Kapitel, Kapitel neu schreiben, Korrektur, Unterlage, Auswertung) wegen
+        der Abrechnung noch nicht startet. Nur für SL der Kampagne (Spieler bekommen null). Die App formuliert den Satz
+        selbst, je nach Fassung (Store-Fassung ohne Link und ohne Knopf zum Aufladen).
+        - approval: Schätzung über dem Freigabe-Betrag; wartet auf „Verarbeiten“.
+        - empty: Guthaben aufgebraucht (≤ 0).
+        - too_low: Guthaben reicht voraussichtlich nicht (Schätzung über dem Deckel).
+        - no_payer: Niemand zahlt für die Kampagne (zahlende SL ist weg); eine SL kann übernehmen.
+        - pot: Topf der Organisation reicht nicht oder wartet auf die Verwalter (SL ohne Verwalterrecht sehen nur das).
+        Unbekannte Werte zeigt die App als „wartet auf das Guthaben“.
+      required: [reason]
+      properties:
+        reason: { type: string, enum: [approval, empty, too_low, no_payer, pot] }
+        estimateCents:
+          type: [integer, "null"]
+          minimum: 0
+          description: Geschätzte Kosten in Cent – nur für Personen, die das zahlende Guthaben sehen dürfen, sonst null.
+        creditId:
+          type: [string, "null"]
+          description: Das zahlende Guthaben – nur für Personen, die es sehen dürfen, sonst null.
+        jobId:
+          type: [string, "null"]
+          description: Für „Verarbeiten“ (POST /credits/{creditId}/waiting/{jobId}/approve); nur zusammen mit creditId.
+
