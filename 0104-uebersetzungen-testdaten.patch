+      const head = ref[1].replace(/\s*…$/, '').trim();
+      const i = paras.findIndex((p) => p.trim().startsWith(head));
+      target = i >= 0 ? i : null;
+      rest = line.slice(ref[0].length);
+    }
+    for (const sentence of sentences(rest)) items.push({ sentence, target });
+  }
