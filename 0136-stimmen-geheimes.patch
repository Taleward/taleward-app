+
+/* Stimmen: bis zu drei Textproben mit eigener Hörprobe, Hinweis bei verdächtiger Zuordnung (ab Schnittstelle 0.4.21) */
+.speaker-samples { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
+.speaker-samples li { display: flex; align-items: center; gap: 10px; }
+.speaker-samples .quote { flex: 1; }
+.speaker-hint {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 12px;
+  color: var(--siegel-text);
+  font-size: calc(15px * var(--ts));
+  font-weight: 500;
+}
+.speaker-hint > span:first-child { flex: 1 1 220px; }
+
+/* Vorschlag klingt wie ein vorhandener Eintrag */
+.proposal-match {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 10px 12px;
+  border-radius: var(--radius-sm);
+  background: var(--paper-sunken);
+  font-size: calc(15px * var(--ts));
+}
+
+/* Kapitel prüfen: Geheimes im Kapitel (nur SL) */
+.secret-warning {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 12px 14px;
+  border: 1.5px solid var(--siegel-text);
+  border-radius: var(--radius-sm);
+  background: var(--paper-raised);
