From 10e65a53ad56b645a25d4f37f147fa81e20ae37a Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:50:39 +0100
Subject: [PATCH] Wortlaut beim E-Mail-Hinweis

---
 src/components/EmailNudge.tsx    | 2 +-
 src/components/LoginSettings.tsx | 4 ++--
 src/i18n/en.ts                   | 2 +-
 src/mocks/billing.ts             | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/components/EmailNudge.tsx b/src/components/EmailNudge.tsx
index de1ea6b..e9ccc7f 100644
--- a/src/components/EmailNudge.tsx
+++ b/src/components/EmailNudge.tsx
@@ -8,5 +8,5 @@ import { t } from '../i18n';
 
 /*
- * Einmal nach dem Anlegen eines Kontos: freundlicher Hinweis, eine E-Mail fürs Passwort-Zurücksetzen zu hinterlegen.
+ * Einmal nach dem Anlegen eines Kontos: freundlicher Hinweis, eine E-Mail zum Zurücksetzen des Passworts zu hinterlegen.
  * Freiwillig, je Server und Konto genau einmal („Nein danke“ = nie wieder), nur wenn der Server Mails verschicken kann,
  * nicht während einer Aufnahme und nicht neben den Nutzungsbedingungen.
diff --git a/src/components/LoginSettings.tsx b/src/components/LoginSettings.tsx
index 1eee504..9c2ce8d 100644
--- a/src/components/LoginSettings.tsx
+++ b/src/components/LoginSettings.tsx
@@ -9,5 +9,5 @@ import { ErrorBox } from './Screen';
 
 /**
- * Konten und Server → Anmeldung: freiwillige E-Mail (nur fürs Passwort-Zurücksetzen), verbundene Dienste,
+ * Konten und Server → Anmeldung: freiwillige E-Mail (nur zum Zurücksetzen des Passworts), verbundene Dienste,
  * Passwort setzen oder ändern (Schnittstelle 0.4.0). Auf älteren Servern unsichtbar.
  */
@@ -70,5 +70,5 @@ export function LoginSettings({ conn, open }: { conn: Connection; open?: boolean
           {!user.email && info.passwordReset && (
             <span className="muted small" style={{ fontWeight: 400 }}>
-              {user.emailPending ? t('E-Mail: wartet auf Bestätigung') : t('E-Mail: noch keine – fürs Passwort-Zurücksetzen')}
+              {user.emailPending ? t('E-Mail: wartet auf Bestätigung') : t('E-Mail: noch keine – zum Zurücksetzen des Passworts')}
             </span>
           )}
diff --git a/src/i18n/en.ts b/src/i18n/en.ts
index db8ee27..2d22676 100644
--- a/src/i18n/en.ts
+++ b/src/i18n/en.ts
@@ -1534,5 +1534,5 @@ export const en: Record<string, string> = {
   "Nein danke": "No thanks",
   "E-Mail: wartet auf Bestätigung": "Email: waiting for confirmation",
-  "E-Mail: noch keine – fürs Passwort-Zurücksetzen": "Email: none yet – for resetting your password",
+  "E-Mail: noch keine – zum Zurücksetzen des Passworts": "Email: none yet – for resetting your password",
   "Ohne hinterlegte E-Mail hilft dir die Verwaltung deines Servers.": "Without an email address on file, your server's administrators can help you.",
   "Craig ist ein eigener Dienst und bewahrt die Aufnahme bis zum Herunterladen auf seinen Servern auf, nicht sicher in der EU. Sagt das am Tisch dazu.": "Craig is a separate service and keeps the recording on its servers until you download it, not necessarily in the EU. Mention that at the table.",
diff --git a/src/mocks/billing.ts b/src/mocks/billing.ts
index 7f6c5fc..863ace6 100644
--- a/src/mocks/billing.ts
+++ b/src/mocks/billing.ts
@@ -43,5 +43,5 @@ const bookings: Record<string, CreditBooking[]> = {
     { id: 'bk-6', kind: 'usage', amountCents: -72, createdAt: daysAgo(2), usage: { jobKind: 'transcribe', campaignId: 'c-grau', campaignTitle: 'Die Schatten von Grauwacht', sessionNumber: 12, documentTitle: null } },
     { id: 'bk-5', kind: 'usage', amountCents: -12, createdAt: daysAgo(6), usage: { jobKind: 'document', campaignId: 'c-grau', campaignTitle: 'Die Schatten von Grauwacht', sessionNumber: null, documentTitle: 'Stadtplan Grauwacht' } },
-    { id: 'bk-4', kind: 'credit', amountCents: 200, createdAt: daysAgo(9), reason: 'Danke fürs Testen' },
+    { id: 'bk-4', kind: 'credit', amountCents: 200, createdAt: daysAgo(9), reason: 'Danke für den Test' },
     { id: 'bk-3', kind: 'voucher', amountCents: 500, createdAt: daysAgo(12) },
     { id: 'bk-2', kind: 'usage', amountCents: -38, createdAt: daysAgo(13), usage: { jobKind: 'summarize', campaignId: 'c-grau', campaignTitle: 'Die Schatten von Grauwacht', sessionNumber: 11, documentTitle: null } },
