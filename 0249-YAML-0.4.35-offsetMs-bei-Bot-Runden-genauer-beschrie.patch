From 7adb1981d598c75e8b221f91a61f537702edd058 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:52:45 +0100
Subject: [PATCH] YAML 0.4.35: offsetMs bei Bot-Runden genauer beschrieben

---
 docs/session-chronik-api.yaml | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index ae6bdc2..9b9dac8 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -323,5 +323,5 @@ info:
     in der laufenden Bot-Runde mit Zustimmung aufgenommen wird, eine gemerkte Stelle an – wie „Merken“ in der App
     (`/taleward merken`). Die Stelle erscheint in der App über GET /sessions/{id}/bookmarks wie jede andere; offsetMs
-    rechnet der Server bei Bot-Runden aus dem Start und den Pausen. Bookmark.source (app | discord, fehlt = app); die App
+    ist bei Bot-Runden die Zeit seit dem Startton (die Spuren laufen in Pausen still weiter). Bookmark.source (app | discord, fehlt = app); die App
     zeigt bei solchen Stellen „Über Discord gemerkt“. Ältere Apps übergehen das Feld.
 
@@ -3775,6 +3775,7 @@ paths:
         (429). `note` bereinigt der Server wie andere Texte vom Bot (Steuerzeichen, Länge). `at` liegt zwischen
         `recordingStartedAt` und jetzt + 5 Minuten (sonst 400). `offsetMs` rechnet der Server bei Bot-Runden aus
-        `recordingStartedAt` und den `pause`/`resume`-Ereignissen (in einer Pause: null). Der Bot zeigt die Antwort nur der
-        Person selbst (ephemeral) und speichert weder Notiz noch Stelle. Die Stelle trägt `source: discord`.
+        `recordingStartedAt`: Zeit seit dem Startton, weil die Spuren in Pausen still weiterlaufen; in einer Pause und nach
+        dem Ende null. Der Bot zeigt die Antwort nur der Person selbst (ephemeral) und speichert weder Notiz noch Stelle.
+        Die Stelle trägt `source: discord`.
       security: [{ botKey: [] }]
       requestBody:
@@ -5517,5 +5518,5 @@ components:
           type: [integer, "null"]
           description: |
-            Zeit in der Aufnahme (aus Upload spans; ab 0.4.35 bei Bot-Runden aus Start und Pausen); null, solange
+            Zeit in der Aufnahme (aus Upload spans; ab 0.4.35 bei Bot-Runden die Zeit seit dem Startton, in Pausen null); null, solange
             unbekannt oder außerhalb der Aufnahme
         recapParagraph:
