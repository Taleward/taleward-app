+
+/* Bibel: Suche über alles, Reiter über die ganze Breite, Einträge als Liste */
+.bible-bar { display: flex; gap: var(--space-2); align-items: center; }
+.bible-bar input { flex: 1; min-width: 0; }
+.btn.square { width: 48px; min-width: 48px; padding: 0; }
+.tabs { display: flex; border-bottom: 1px solid var(--line); }
+.tabs button {
+  flex: 1 1 0; max-width: 160px; min-width: 0; min-height: 60px; padding: 6px 2px;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
+  background: none; border: 0; border-bottom: 3px solid transparent;
+  font: 500 calc(16px * var(--ts))/1.2 var(--font-sans); color: var(--ink-muted); cursor: pointer;
+}
+.tabs button .n { font-size: calc(13px * var(--ts)); }
+.tabs button[aria-pressed='true'] { border-bottom-color: var(--ink); color: var(--ink); font-weight: 700; }
+@media (hover: hover) { .tabs button:hover { background: var(--paper-sunken); } }
+.list-row.entry { align-items: flex-start; padding: 12px 0; }
+.list-row.entry .lr-text { gap: 3px; }
+.entry-name { font: 700 calc(19px * var(--ts))/1.3 var(--font-serif); }
+.entry-sum {
+  font: 400 calc(15px * var(--ts))/1.4 var(--font-sans);
+  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
+}
+.entry-tag { display: inline-flex; align-items: center; gap: 4px; font: 500 calc(13px * var(--ts))/1.3 var(--font-sans); color: var(--siegel-text); }
+.entry-text { margin: 0; font-size: calc(17px * var(--ts)); line-height: 1.55; white-space: pre-wrap; }
+mark { background: var(--paper-sunken); color: var(--ink); padding: 0; border-radius: 2px; box-shadow: inset 0 -2px 0 var(--messing); }
+/* Leiser Nebenweg als unterstrichener Text, trotzdem groß genug zum Tippen */
+.quiet-link {
+  align-self: flex-start; display: inline-flex; align-items: center; min-height: 48px; padding: 0 2px;
+  background: none; border: 0; color: var(--ink-muted); font: 500 calc(15px * var(--ts))/1.3 var(--font-sans);
+  text-decoration: underline; cursor: pointer;
+}
+.quiet-link.danger { color: var(--siegel-text); }
