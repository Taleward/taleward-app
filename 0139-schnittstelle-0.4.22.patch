From 906035516ab1bbbf7befff34fbcdd0f19325507d Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Fri, 16 Oct 2026 16:52:16 +0200
Subject: [PATCH 139/140] Schnittstelle 0.4.22: Impressum und
 Nutzungsbedingungen je Server

ServerInfo.legalNoticeUrl, termsUrl, termsVersion; Zustimmung bei der Registrierung, User.termsAcceptedVersion, PUT /me/terms; ohne Zustimmung zur aktuellen Fassung nur lesen.
---
 docs/session-chronik-api.yaml    | 69 +++++++++++++++++++++++++++++++-
 scripts/tests/safe-link.test.mjs |  3 ++
 src/api/client.ts                |  9 +++--
 src/api/safeUrl.ts               |  7 +++-
 src/api/types.ts                 |  9 +++++
 5 files changed, 91 insertions(+), 6 deletions(-)

diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index fcbf119..3cc6244 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -2,5 +2,5 @@ openapi: 3.1.0
 info:
   title: Taleward API
-  version: 0.4.21
+  version: 0.4.22
   description: |
     Schnittstelle zwischen der Taleward-App (Android, Web) und dem Taleward-Server.
@@ -217,4 +217,11 @@ info:
     Textproben je Stimme mit eigener Hörprobe (GET …/sample?index=), Speaker.hint – Anrede oder Selbstnennung passt
     nicht zur Zuordnung. Ältere Apps sehen weiter sampleText und lassen die neuen Felder weg.
+    Änderungen in 0.4.22 (Impressum und Nutzungsbedingungen je Server): Jeder Server hat ab 0.4.22 Nutzungsbedingungen
+    (Vorlage aus dem Einrichtungsassistenten oder eigener Link) und meldet sie in ServerInfo.termsUrl und termsVersion,
+    dazu ServerInfo.legalNoticeUrl (Impressum). Registrieren nur mit acceptTerms und der gezeigten termsVersion (beides
+    mit Zeitpunkt protokollieren). User.termsAcceptedVersion/termsAcceptedAt; PUT /me/terms für die Zustimmung zu einer
+    neuen Fassung. Solange sie fehlt, antwortet der Server auf ändernde Anfragen mit 403 `terms_required` – lesen,
+    Zustimmungen widerrufen, laufende Aufnahmen fertig hochladen, Daten herunterladen und das Konto löschen gehen weiter.
+    Das gilt auch für Konten, die vor dem Update angelegt wurden (termsAcceptedVersion null).
 
 servers:
@@ -300,4 +307,7 @@ paths:
         Legt nur das Konto an – den Beitritt zur Kampagne macht die App danach mit POST /campaigns/join.
         acceptPrivacy und ageConfirmed müssen true sein (400 `consent_required`); beides mit Zeitpunkt protokollieren.
+        Ab 0.4.22 zusätzlich acceptTerms true und termsVersion = ServerInfo.termsVersion (fehlt eins → 400
+        `consent_required`; andere Fassung → 409 `terms_changed`, die App lädt /info neu und zeigt die neue Fassung).
+        Zeitpunkt und Fassung protokollieren; termsAcceptedVersion des neuen Kontos ist danach diese Fassung.
         Passwort mindestens 8 Zeichen (400 `weak_password`), Benutzername eindeutig (409 `username_taken`).
         Gegen Durchprobieren von Codes: Anfragen pro Adresse begrenzen (429).
@@ -319,4 +329,6 @@ paths:
                     acceptPrivacy: { type: boolean, enum: [true] }
                     ageConfirmed: { type: boolean, enum: [true], description: "Mindestalter aus /info erreicht oder Eltern einverstanden" }
+                    acceptTerms: { type: boolean, enum: [true], description: "Ab 0.4.22 Pflicht: Nutzungsbedingungen aus /info" }
+                    termsVersion: { type: integer, minimum: 1, description: "Ab 0.4.22 Pflicht: die Fassung, der zugestimmt wurde" }
                 - type: object
                   title: Nach Anmeldung mit einem Dienst (ab 0.4.0)
@@ -332,4 +344,6 @@ paths:
                     acceptPrivacy: { type: boolean, enum: [true] }
                     ageConfirmed: { type: boolean, enum: [true] }
+                    acceptTerms: { type: boolean, enum: [true], description: "Ab 0.4.22 Pflicht, wie oben" }
+                    termsVersion: { type: integer, minimum: 1, description: "Ab 0.4.22 Pflicht, wie oben" }
       responses:
         "201":
@@ -450,4 +464,32 @@ paths:
         "409": { $ref: "#/components/responses/Conflict" }
 
+  /me/terms:
+    put:
+      tags: [Auth]
+      summary: Einer neuen Fassung der Nutzungsbedingungen zustimmen (ab 0.4.22)
+      description: |
+        version muss ServerInfo.termsVersion sein (sonst 409 `terms_changed`; die App lädt /info neu). Zeitpunkt und Fassung
+        protokollieren. Antwort ist das eigene Profil mit neuer termsAcceptedVersion. Eine Zustimmung lässt sich nicht
+        einzeln zurücknehmen; wer nicht mehr einverstanden ist, löscht das Konto (DELETE /me).
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [accept, version]
+              properties:
+                accept: { type: boolean, enum: [true] }
+                version: { type: integer, minimum: 1 }
+      responses:
+        "200":
+          description: Zugestimmt
+          content:
+            application/json:
+              schema: { $ref: "#/components/schemas/User" }
+        "400": { $ref: "#/components/responses/BadRequest" }
+        "401": { $ref: "#/components/responses/Unauthorized" }
+        "409": { $ref: "#/components/responses/Conflict" }
+
   /me/email:
     put:
@@ -3079,4 +3121,21 @@ components:
         authMethods: { type: array, items: { type: string, enum: [password, oidc, passkey] }, description: "oidc, sobald mindestens ein Dienst eingerichtet ist" }
         privacyPolicyUrl: { type: [string, "null"] }
+        legalNoticeUrl:
+          type: [string, "null"]
+          description: |
+            Ab 0.4.22: Impressum des Betreibers (Vorlage des Servers unter `/impressum` oder eigener Link aus der Verwaltung).
+            null = keins angegeben. Die App zeigt es unter „Konten und Server“ bei diesem Server.
+        termsUrl:
+          type: [string, "null"]
+          description: |
+            Ab 0.4.22 immer gesetzt: Nutzungsbedingungen des Betreibers (Vorlage unter `/nutzungsbedingungen` oder eigener
+            Link). Fehlt das Feld oder ist es null (ältere Server), fragt die App nicht danach.
+        termsVersion:
+          type: [integer, "null"]
+          minimum: 1
+          description: |
+            Ab 0.4.22: Fassung der Nutzungsbedingungen. Der Betreiber zählt sie in der Verwaltung hoch, wenn eine Änderung
+            eine neue Zustimmung braucht (Tippfehler: nicht hochzählen). Ist sie höher als User.termsAcceptedVersion,
+            zeigt die App die neue Fassung mit „Zustimmen“ und weist darauf hin, dass bis dahin nur Lesen geht.
         minAge: { type: integer, example: 16 }
         minAppVersion: { type: [string, "null"], example: "0.10.0", description: "Ältere Apps bekommen 426 app_outdated; null = keine Grenze" }
@@ -3364,4 +3423,12 @@ components:
         hasPassword: { type: boolean, description: "false bei Konten, die nur über einen Dienst angelegt wurden (ab 0.4.0)" }
         providers: { type: array, items: { type: string, enum: [google, discord, apple, microsoft] }, description: "Verbundene Dienste (ab 0.4.0)" }
+        termsAcceptedVersion:
+          type: [integer, "null"]
+          description: |
+            Ab 0.4.22: zuletzt zugestimmte Fassung der Nutzungsbedingungen; null = noch nie (z. B. Konto von vor dem Update).
+            Kleiner als ServerInfo.termsVersion → ändernde Anfragen enden mit 403 `terms_required`, außer: PUT /me/terms,
+            DELETE /me, GET /me/export, alles unter /auth, Zustimmung zu Aufnahmen widerrufen (PUT …/recording-consent mit
+            granted false), Hochladen einer schon begonnenen Aufnahme (/uploads/…) und Abmelden. Lesen geht immer.
+        termsAcceptedAt: { type: [string, "null"], format: date-time, description: "Ab 0.4.22, Zeitpunkt dieser Zustimmung" }
 
     VoiceProfile:
diff --git a/scripts/tests/safe-link.test.mjs b/scripts/tests/safe-link.test.mjs
index d8fac25..9867c2a 100644
--- a/scripts/tests/safe-link.test.mjs
+++ b/scripts/tests/safe-link.test.mjs
@@ -18,3 +18,6 @@ test('Server-Info wird bereinigt, andere Felder bleiben', () => {
   const info = withSafeLinks({ name: 'Verein', privacyPolicyUrl: 'javascript:alert(1)', appDownloadUrl: 'https://verein.de/taleward.apk' });
   assert.deepEqual(info, { name: 'Verein', privacyPolicyUrl: null, appDownloadUrl: 'https://verein.de/taleward.apk' });
+  const legal = withSafeLinks({ privacyPolicyUrl: null, legalNoticeUrl: 'data:text/html,x', termsUrl: 'https://verein.de/nutzungsbedingungen' });
+  assert.equal(legal.legalNoticeUrl, null);
+  assert.equal(legal.termsUrl, 'https://verein.de/nutzungsbedingungen');
 });
diff --git a/src/api/client.ts b/src/api/client.ts
index 5f4e686..2b8377c 100644
--- a/src/api/client.ts
+++ b/src/api/client.ts
@@ -228,8 +228,11 @@ function makeApi(conn: () => Connection) {
   me: () => request<User>('GET', '/me'),
   info: () => request<ServerInfo>('GET', '/info').then(withSafeLinks),
-  register: (data:
-    | { inviteCode: string; username: string; displayName: string; password: string; acceptPrivacy: true; ageConfirmed: true }
-    | { inviteCode: string; registrationToken: string; displayName: string; acceptPrivacy: true; ageConfirmed: true }) =>
+  /** acceptTerms und termsVersion ab 0.4.22, wenn der Server Nutzungsbedingungen meldet */
+  register: (data: ({ inviteCode: string; username: string; displayName: string; password: string; acceptPrivacy: true; ageConfirmed: true }
+    | { inviteCode: string; registrationToken: string; displayName: string; acceptPrivacy: true; ageConfirmed: true })
+    & { acceptTerms?: true; termsVersion?: number }) =>
     request<{ accessToken: string; expiresAt: string; user: User }>('POST', '/auth/register', { body: data }),
+  /** Neuer Fassung der Nutzungsbedingungen zustimmen (ab 0.4.22) */
+  acceptTerms: (version: number) => request<User>('PUT', '/me/terms', { body: { accept: true, version } }),
   exportMe: () => request<Blob>('GET', '/me/export'),
   /** Konten mit Passwort: { password }, ohne Passwort: { confirmUsername } */
diff --git a/src/api/safeUrl.ts b/src/api/safeUrl.ts
index 49e1187..d71df96 100644
--- a/src/api/safeUrl.ts
+++ b/src/api/safeUrl.ts
@@ -14,9 +14,12 @@ export function safeLink(url: string | null | undefined): string | null {
 
 /** Server-Info mit geprüften Adressen */
-export function withSafeLinks<T extends { privacyPolicyUrl?: string | null; appDownloadUrl?: string | null }>(info: T): T {
+export function withSafeLinks<T extends { privacyPolicyUrl?: string | null; appDownloadUrl?: string | null; legalNoticeUrl?: string | null; termsUrl?: string | null }>(info: T): T {
   return {
     ...info,
     privacyPolicyUrl: safeLink(info.privacyPolicyUrl),
-    ...('appDownloadUrl' in info ? { appDownloadUrl: safeLink(info.appDownloadUrl) } : {})
+    ...('appDownloadUrl' in info ? { appDownloadUrl: safeLink(info.appDownloadUrl) } : {}),
+    // Impressum und Nutzungsbedingungen (ab 0.4.22)
+    ...('legalNoticeUrl' in info ? { legalNoticeUrl: safeLink(info.legalNoticeUrl) } : {}),
+    ...('termsUrl' in info ? { termsUrl: safeLink(info.termsUrl) } : {})
   };
 }
diff --git a/src/api/types.ts b/src/api/types.ts
index 4d4f386..463411c 100644
