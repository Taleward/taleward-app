diff --git a/scripts/tests/desktop-shell.test.mjs b/scripts/tests/desktop-shell.test.mjs
new file mode 100644
index 0000000..52957cf
--- /dev/null
+++ b/scripts/tests/desktop-shell.test.mjs
@@ -0,0 +1,20 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseShellHello, shellOrigin } from '../../src/display/desktopShell.ts';
+
+test('Programmfenster nur, wenn die App direkt in der Oberfläche auf diesem PC steckt', () => {
+  assert.equal(shellOrigin(['http://localhost:51234'], 'http://localhost:8000', false), 'http://localhost:51234');
+  assert.equal(shellOrigin(['http://127.0.0.1:51234'], 'http://localhost:8000', false), 'http://127.0.0.1:51234');
+  assert.equal(shellOrigin([], 'http://localhost:8000', true), null);
+  assert.equal(shellOrigin(['https://fremd.example'], 'http://localhost:8000', false), null);
+  assert.equal(shellOrigin(['http://localhost:1', 'http://localhost:2'], 'http://localhost:8000', false), null);
+  assert.equal(shellOrigin(['http://localhost:51234'], 'https://app.taleward.org', false), null);
+  assert.equal(shellOrigin(undefined, 'http://localhost:8000', false), null);
+});
+
+test('Nachricht der Oberfläche: nur bekannte Hilfen', () => {
+  assert.deepEqual(parseShellHello({ taleward: 'desktop', can: ['mic-settings', 'irgendwas'] }), ['mic-settings']);
+  assert.equal(parseShellHello({ taleward: 'anders', can: [] }), null);
+  assert.equal(parseShellHello('mic-settings'), null);
+  assert.equal(parseShellHello(null), null);
+});
diff --git a/src/components/MicDenied.tsx b/src/components/MicDenied.tsx
new file mode 100644
index 0000000..96c4714
--- /dev/null
+++ b/src/components/MicDenied.tsx
@@ -0,0 +1,36 @@
+import { useEffect, useState } from 'react';
+import { Capacitor } from '@capacitor/core';
+import { t } from '../i18n';
+import { inDesktopShell, onShellChange, openMicSettings, shellCan } from '../display/desktopShell';
+
+/**
+ * Kein Zugriff aufs Mikrofon – mit dem Weg, der hier wirklich hilft: Android-App (App-Einstellungen), Programmfenster
+ * unter Windows (Datenschutz → Mikrofon, mit Knopf, sobald das Programm ihn anbietet) oder Browser (Seiteneinstellungen).
+ */
+export function MicDenied() {
+  const [, redraw] = useState(0);
+  useEffect(() => onShellChange(() => redraw((n) => n + 1)), []);
+  const desktop = inDesktopShell();
+
+  return (
+    <div className="card warn" role="alert">
+      <strong>{t('Kein Zugriff aufs Mikrofon')}</strong>
+      {Capacitor.isNativePlatform() ? (
+        <span className="small">{t('Erlaube ihn in den App-Einstellungen des Handys.')}</span>
+      ) : desktop ? (
+        <>
+          <span className="small">
+            {t('Windows lässt Taleward gerade nicht ans Mikrofon. In den Windows-Einstellungen unter „Datenschutz und Sicherheit“ → „Mikrofon“ „Desktop-Apps den Zugriff erlauben“ einschalten, dann hier noch einmal starten.')}
+          </span>
+          {shellCan('mic-settings') && (
+            <button type="button" className="btn small outline" style={{ alignSelf: 'flex-start' }} onClick={openMicSettings}>
+              {t('Einstellungen öffnen')}
+            </button>
+          )}
+        </>
+      ) : (
+        <span className="small">{t('Erlaube ihn in den Einstellungen des Browsers für diese Seite (Schloss oder Symbol links neben der Adresse) und starte noch einmal.')}</span>
+      )}
+    </div>
+  );
+}
diff --git a/src/display/desktopShell.ts b/src/display/desktopShell.ts
new file mode 100644
index 0000000..8cb39ec
--- /dev/null
+++ b/src/display/desktopShell.ts
@@ -0,0 +1,78 @@
+/**
+ * Läuft die App im Programmfenster „Taleward Desktop“? Dort steckt sie in einem Rahmen der Programmoberfläche
+ * (http://localhost:<Anschluss>), die selbst nur unter localhost läuft. Erkennung über `location.ancestorOrigins`
+ * (Chromium/WebView2) – keine Abfrage, kein Speicher.
+ *
+ * Absprache mit der Programmoberfläche (nur Nachrichten zwischen den beiden Fenstern):
+ * - App → Oberfläche: `{ taleward: 'hello' }` beim Start, `{ taleward: 'mic-settings' }` für den Knopf.
+ * - Oberfläche → App: `{ taleward: 'desktop', can: ['mic-settings'] }` – erst danach zeigt die App den Knopf.
+ * Die Oberfläche öffnet dafür fest die Mikrofon-Seite der Windows-Einstellungen, ohne Angaben aus der Nachricht.
+ */
+
+const SHELL = /^http:\/\/(localhost|127\.0\.0\.1|\[::1\]):\d{1,5}$/;
+
+/** Herkunft der Programmoberfläche, wenn die App direkt darin steckt – sonst null */
+export function shellOrigin(ancestors: ArrayLike<string> | undefined, self: string, top: boolean): string | null {
+  if (top || !ancestors || ancestors.length !== 1) return null;
+  const parent = ancestors[0];
+  if (!SHELL.test(parent)) return null;
+  // Die App selbst kommt vom Server auf demselben PC
+  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\]):\d{1,5}$/.test(self)) return null;
+  return parent;
+}
+
+/** Nachricht der Oberfläche lesen: welche Hilfen sie anbietet (nur bekannte Namen) */
+export function parseShellHello(data: unknown): string[] | null {
+  if (!data || typeof data !== 'object') return null;
+  const d = data as { taleward?: unknown; can?: unknown };
+  if (d.taleward !== 'desktop' || !Array.isArray(d.can)) return null;
+  return d.can.filter((x): x is string => x === 'mic-settings');
+}
+
+let origin: string | null | undefined;
+let can: string[] = [];
+const listeners = new Set<() => void>();
+
+function detect(): string | null {
+  if (origin !== undefined) return origin;
+  try {
+    origin = shellOrigin(location.ancestorOrigins, location.origin, window.top === window);
+  } catch {
+    origin = null;
+  }
+  if (origin) {
+    const from = origin;
+    window.addEventListener('message', (e) => {
+      if (e.origin !== from || e.source !== window.parent) return;
+      const c = parseShellHello(e.data);
+      if (!c) return;
+      can = c;
+      listeners.forEach((l) => l());
+    });
+    window.parent.postMessage({ taleward: 'hello' }, from);
+  }
+  return origin;
+}
+
+/** Im Programmfenster? */
+export function inDesktopShell(): boolean {
+  return detect() !== null;
+}
+
+/** Bietet die Oberfläche den Weg zu den Mikrofon-Einstellungen an? */
+export function shellCan(what: 'mic-settings'): boolean {
+  detect();
+  return can.includes(what);
+}
+
+export function onShellChange(cb: () => void): () => void {
+  detect();
+  listeners.add(cb);
+  return () => { listeners.delete(cb); };
+}
+
+/** Windows-Einstellungen → Mikrofon öffnen (macht die Programmoberfläche) */
+export function openMicSettings(): void {
+  const o = detect();
+  if (o && can.includes('mic-settings')) window.parent.postMessage({ taleward: 'mic-settings' }, o);
+}
