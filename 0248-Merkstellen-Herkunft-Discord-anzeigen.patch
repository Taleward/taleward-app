From 96ec9d1a2368917d1cfb8019522c2d2a867eabd0 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:46:34 +0100
Subject: [PATCH] Merkstellen: Herkunft Discord anzeigen

---
 docs/session-chronik-api.yaml | 12 ++++++++++--
 src/api/types.ts              |  2 ++
 src/components/Bookmarks.tsx  |  2 +-
 src/i18n/en.ts                |  1 +
 src/mocks/players.ts          |  2 +-
 5 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index a6773ad..ae6bdc2 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -323,5 +323,6 @@ info:
     in der laufenden Bot-Runde mit Zustimmung aufgenommen wird, eine gemerkte Stelle an – wie „Merken“ in der App
     (`/taleward merken`). Die Stelle erscheint in der App über GET /sessions/{id}/bookmarks wie jede andere; offsetMs
-    rechnet der Server bei Bot-Runden aus dem Start und den Pausen. App-Oberfläche unverändert.
+    rechnet der Server bei Bot-Runden aus dem Start und den Pausen. Bookmark.source (app | discord, fehlt = app); die App
+    zeigt bei solchen Stellen „Über Discord gemerkt“. Ältere Apps übergehen das Feld.
 
 servers:
@@ -3775,5 +3776,5 @@ paths:
         `recordingStartedAt` und jetzt + 5 Minuten (sonst 400). `offsetMs` rechnet der Server bei Bot-Runden aus
         `recordingStartedAt` und den `pause`/`resume`-Ereignissen (in einer Pause: null). Der Bot zeigt die Antwort nur der
-        Person selbst (ephemeral) und speichert weder Notiz noch Stelle.
+        Person selbst (ephemeral) und speichert weder Notiz noch Stelle. Die Stelle trägt `source: discord`.
       security: [{ botKey: [] }]
       requestBody:
@@ -5523,4 +5524,11 @@ components:
             Nach dem Veröffentlichen: Absatz des Kapitels (ab 0 in Recap.text), der diese Stelle erzählt – soweit der
             Server ihn über die Belege findet; sonst null. Nur ein Hinweis, das Kapitel ändert sich dadurch nicht.
+        source:
+          type: string
+          enum: [app, discord]
+          description: |
+            Ab 0.4.35: woher die Stelle kam – `app` (POST /sessions/{id}/bookmarks) oder `discord` (über den Bot,
+            `/taleward merken`). Fehlt das Feld, gilt `app`. Die App zeigt „Über Discord gemerkt“, damit die Person eine
+            nicht selbst in der App gesetzte Stelle erkennt und löschen kann.
         createdAt: { type: string, format: date-time }
 
diff --git a/src/api/types.ts b/src/api/types.ts
index 04dec98..521e4f6 100644
--- a/src/api/types.ts
+++ b/src/api/types.ts
@@ -174,4 +174,6 @@ export interface Bookmark {
   offsetMs?: number | null;
   recapParagraph?: number | null;
+  /** Ab 0.4.35: woher die Stelle kam (fehlt = app) */
+  source?: 'app' | 'discord';
   createdAt: string;
 }
diff --git a/src/components/Bookmarks.tsx b/src/components/Bookmarks.tsx
index df95381..8a8eb41 100644
--- a/src/components/Bookmarks.tsx
+++ b/src/components/Bookmarks.tsx
@@ -106,5 +106,5 @@ export function MyBookmarks({ list, onJump, onDelete }: { list: Bookmark[]; onJu
         {list.map((b) => {
           const label = <span className="lr-text">{clock(b.at)}{b.note ? ` · ${b.note}` : ''}
-            <span className="lr-sub">{b.recapParagraph != null ? t('Zur Stelle im Kapitel') : t('Die Stelle ließ sich keinem Absatz zuordnen.')}</span></span>;
+            <span className="lr-sub">{b.source === 'discord' ? `${t('Über Discord gemerkt')} · ` : ''}{b.recapParagraph != null ? t('Zur Stelle im Kapitel') : t('Die Stelle ließ sich keinem Absatz zuordnen.')}</span></span>;
           return (
             <div key={b.id} className="file-row">
diff --git a/src/i18n/en.ts b/src/i18n/en.ts
index e807a60..796a03d 100644
--- a/src/i18n/en.ts
+++ b/src/i18n/en.ts
@@ -1878,3 +1878,4 @@ export const en: Record<string, string> = {
   "Noch nichts passiert.": "Nothing yet.",
   "Eigene Spur im Discord": "Own track in Discord",
+  "Über Discord gemerkt": "Marked via Discord",
 };
