 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/characters/FileViewer.tsx b/src/characters/FileViewer.tsx
index 78b9f7d..99f238d 100644
--- a/src/characters/FileViewer.tsx
+++ b/src/characters/FileViewer.tsx
@@ -24,5 +24,5 @@ export function FileViewer() {
   // „Mit einer anderen App öffnen“ als Zeichen oben rechts, neben der Seitenangabe
   const openOther = file ? (
-    <button type="button" className="btn outline square" aria-label={t('Mit einer anderen App öffnen')} title={t('Mit einer anderen App öffnen')}
+    <button type="button" className="icon-btn" aria-label={t('Mit einer anderen App öffnen')} title={t('Mit einer anderen App öffnen')}
       onClick={() => openWithDevice(file, file.name).catch(setError)}><IconExternal size={18} /></button>
   ) : null;
@@ -146,6 +146,6 @@ function PdfPages({ file, onError, openOther }: { file: StoredCharacterFile; onE
         <span className="row" style={{ gap: 6 }}>
           {openOther}
-          <button type="button" className="btn outline square" aria-label={t('Kleiner')} disabled={zoom <= 1} onClick={() => setZoom((z) => Math.max(1, z - 0.5))}><IconMinus size={18} /></button>
-          <button type="button" className="btn outline square" aria-label={t('Größer')} disabled={zoom >= 3} onClick={() => setZoom((z) => Math.min(3, z + 0.5))}><IconPlus size={18} /></button>
+          <button type="button" className="icon-btn" aria-label={t('Kleiner')} disabled={zoom <= 1} onClick={() => setZoom((z) => Math.max(1, z - 0.5))}><IconMinus size={18} /></button>
+          <button type="button" className="icon-btn" aria-label={t('Größer')} disabled={zoom >= 3} onClick={() => setZoom((z) => Math.min(3, z + 0.5))}><IconPlus size={18} /></button>
         </span>
       </div>
diff --git a/src/theme.css b/src/theme.css
index 840794a..c5880df 100644
--- a/src/theme.css
+++ b/src/theme.css
@@ -2326,4 +2326,10 @@ mark { background: var(--paper-sunken); color: var(--ink); padding: 0; border-ra
 
 /* Unterlagen aus der Sammlung lesen (PDF) */
+/* Leises Zeichen ohne Rahmen (Werkzeuge am Rand einer Ansicht), Tippfläche 48 px */
+.icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; padding: 0;
+  background: none; border: 0; border-radius: var(--radius-pill); color: var(--ink-muted); cursor: pointer; }
+.icon-btn:hover:not(:disabled) { color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); }
+.icon-btn:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
+.icon-btn:disabled { opacity: .4; cursor: default; }
 .pdf-scroll { overflow-x: auto; overflow-y: hidden; flex-shrink: 0; -webkit-overflow-scrolling: touch; }
 .pdf-pages { display: flex; flex-direction: column; gap: var(--space-2); }
