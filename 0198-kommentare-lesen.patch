diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index c68f4b2..d4591cb 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -263,4 +263,6 @@ info:
     zu Entry.holderMemberId. Entry.holderMemberId selbst gibt es schon länger (POST/PATCH /entries). Ältere Apps sehen
     den Vorschlag ohne Halter; übernimmt die SL ihn dort, setzt der Server den vorgeschlagenen Halter trotzdem.
+    Außerdem private Kommentare an mehrere Personen: POST …/comments nimmt recipientMemberIds, Comment liefert
+    recipientMemberIds. recipientMemberId bleibt (erster Empfänger) für ältere Apps.
 
 servers:
@@ -2950,4 +2952,7 @@ paths:
       description: |
         `recipientMemberId` leer = für alle. Gesetzt = privat, sichtbar nur für Absender und Empfänger.
+        Ab 0.4.26 `recipientMemberIds` (geht vor `recipientMemberId`): privat an mehrere Personen, sichtbar für Absender
+        und alle Empfänger; jede von ihnen sieht auch, an wen der Kommentar sonst noch ging. Leer oder fehlend = für alle.
+        Höchstens 20, keine doppelten, nicht der Absender selbst (sonst 400 `recipient_unknown`).
         Spieler dürfen privat nur an die SL schreiben (sonst 403), die SL an jede Person.
         Leerer Text 400, mehr als 4000 Zeichen 413 `comment_too_long`.
@@ -2962,4 +2967,9 @@ paths:
                 text: { type: string, maxLength: 4000 }
                 recipientMemberId: { type: [string, "null"] }
+                recipientMemberIds:
+                  type: array
+                  maxItems: 20
+                  items: { type: string }
+                  description: Ab 0.4.26, siehe oben
       responses:
         "201":
@@ -4568,5 +4578,13 @@ components:
         recipientMemberId:
           type: [string, "null"]
-          description: null = für alle; sonst privat (nur Absender und Empfänger sehen ihn)
+          description: |
+            null = für alle; sonst privat (nur Absender und Empfänger sehen ihn). Ab 0.4.26 bei mehreren Empfängern der
+            erste (für ältere Apps); maßgeblich ist recipientMemberIds.
+        recipientMemberIds:
+          type: array
+          items: { type: string }
+          description: |
+            Ab 0.4.26, immer gesetzt: alle Empfänger eines privaten Kommentars, leer = für alle. Sichtbar für alle, die den
+            Kommentar sehen. Ältere Apps zeigen nur den ersten Empfänger.
         text: { type: string }
         createdAt: { type: string, format: date-time }
diff --git a/src/api/client.ts b/src/api/client.ts
index 267a306..555e64c 100644
--- a/src/api/client.ts
+++ b/src/api/client.ts
@@ -461,6 +461,9 @@ function makeApi(conn: () => Connection) {
   // Kommentare pro Kapitel
   comments: (sessionId: string) => request<Comment[]>('GET', `/sessions/${sessionId}/comments`),
-  addComment: (sessionId: string, text: string, recipientMemberId: string | null) =>
-    request<Comment>('POST', `/sessions/${sessionId}/comments`, { body: { text, recipientMemberId } }),
+  /** Mehrere Empfänger erst ab 0.4.26; ältere Server bekommen nur den ersten */
+  addComment: (sessionId: string, text: string, recipients: string[], multi: boolean) =>
+    request<Comment>('POST', `/sessions/${sessionId}/comments`, {
+      body: multi ? { text, recipientMemberIds: recipients } : { text, recipientMemberId: recipients[0] ?? null }
+    }),
   editComment: (commentId: string, text: string) =>
     request<Comment>('PATCH', `/comments/${commentId}`, { body: { text } }),
