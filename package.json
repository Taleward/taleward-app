{
  "name": "taleward-app",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "npm test && tsc -b && vite build --mode mock",
    "test": "node --experimental-strip-types --no-warnings --test scripts/tests/*.test.mjs",
    "preview": "vite preview",
    "android": "npm run build && node scripts/setup-android.mjs && npx cap sync android && npx cap open android",
    "android:mock": "npm run build:mock && node scripts/setup-android.mjs && npx cap sync android && npx cap open android",
    "native:setup": "node scripts/setup-android.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:store": "tsc -b && vite build --mode store",
    "android:store": "npm run build:store && node scripts/setup-android.mjs --store && npx cap sync android && npx cap open android",
    "build:web": "tsc -b && vite build --mode web"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^2.15.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Tinkerworks (Benjamin)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Taleward/taleward-app.git"
  }
}
