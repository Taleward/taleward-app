   { pattern: new RegExp(`^/campaigns/${ID}/entries$`), clean: (d) => (Array.isArray(d) ? d.filter(isObj).filter(publicEntry).map(entry) : null) }
 ];
@@ -102,4 +102,9 @@ function recap(r: Obj): Obj {
 }
 
