   "lockfileVersion": 3,
   "requires": true,
@@ -7,5 +7,5 @@
     "": {
       "name": "taleward-app",
-      "version": "0.37.1",
+      "version": "0.38.0",
       "license": "AGPL-3.0-only",
       "dependencies": {
diff --git a/package.json b/package.json
index 8b6c74c..8ba2968 100644
--- a/package.json
+++ b/package.json
@@ -2,5 +2,5 @@
   "name": "taleward-app",
   "private": true,
-  "version": "0.37.1",
+  "version": "0.38.0",
   "type": "module",
   "scripts": {
diff --git a/scripts/tests/billing.test.mjs b/scripts/tests/billing.test.mjs
index 68ea046..762f30a 100644
--- a/scripts/tests/billing.test.mjs
+++ b/scripts/tests/billing.test.mjs
@@ -60,4 +60,6 @@ test('Kontakt des Betreibers: Mail oder https, nie die Aufladeseite', () => {
   assert.equal(operatorContact('https://verein.test/guthaben'), null);
   assert.equal(operatorContact('https://verein.test/Guthaben/aufladen'), null);
+  assert.equal(operatorContact('https://verein.test/%67uthaben'), null);
+  assert.equal(operatorContact('https://verein.test/%2567uthaben'), null);
   assert.equal(operatorContact('https://verein.test/zahlen', { billing: { mode: 'credit', topUpUrl: 'https://verein.test/zahlen' } }), null);
   assert.equal(operatorContact('https://nutzer:pw@verein.test/'), null);
diff --git a/src/billing/rules.ts b/src/billing/rules.ts
index ececcfa..d2dda0e 100644
--- a/src/billing/rules.ts
+++ b/src/billing/rules.ts
@@ -56,5 +56,8 @@ export function operatorContact(contact: string | null | undefined, info?: Billi
   try { u = new URL(/^[a-z][a-z0-9+.-]*:/i.test(c) ? c : 'https://' + c); } catch { return null; }
   if (u.protocol !== 'https:' || u.username || u.password || !u.hostname.includes('.')) return null;
-  if (u.pathname.toLowerCase().startsWith('/guthaben')) return null;
+  // Pfad entschlüsselt vergleichen (auch doppelt kodiert, z. B. /%2567uthaben)
+  let path = u.pathname;
+  for (let i = 0; i < 2; i++) { try { path = decodeURIComponent(path); } catch { return null; } }
+  if (path.toLowerCase().startsWith('/guthaben')) return null;
   const top = info?.billing?.topUpUrl;
   if (top) {
