+
+/* „Mitspielende einladen“ als Zeile in „Am Tisch“ */
+.invite-row { min-height: 52px; gap: 10px; width: 100%; background: none; border: 0; border-top: 1px solid var(--line); padding: 6px 0 0; margin-top: 4px; text-align: left; color: var(--ink); font: inherit; cursor: pointer; }
+.invite-plus { width: 40px; height: 40px; flex: none; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px dashed var(--line-strong); color: var(--ink); }
