diff --git a/docs/session-chronik-api.yaml b/docs/session-chronik-api.yaml
index 1040d04..e04f0d5 100644
--- a/docs/session-chronik-api.yaml
+++ b/docs/session-chronik-api.yaml
@@ -3,3 +3,3 @@ info:
   title: Taleward API
-  version: 0.4.18
+  version: 0.4.19
   description: |
@@ -199,2 +199,8 @@ info:
     ausgewertet werden höchstens 20 Seiten.
+    Änderungen in 0.4.19 (Beziehung bei der mitgebrachten Welt): WorldEntryIn.relation – wie der Eintrag zum Charakter
+    steht („Schwester von Litha“, „alter Lehrmeister“), optional, nur Anzeige. Der Server übernimmt es unverändert in
+    Proposal.relation; in Bibeleinträge geht es nicht von selbst (die SL kann es in den Text übernehmen). Die App schickt
+    das Feld erst an Server ab 0.4.19; ältere Apps lassen es weg. Außerdem Campaign.characterSheetLimits – die geltenden
+    Grenzen für Charakterbögen (Bögen je Mitglied, ausgewertete Seiten), damit die App keine festen Zahlen nennt; 409
+    `sheet_limit` richtet sich nach maxSheets.
 
@@ -3480,2 +3486,13 @@ components:
                 älteren Servern (= aus).
+            characterSheetLimits:
+              type: [object, "null"]
+              description: |
+                Ab 0.4.19, für alle Mitglieder: die Grenzen, die für Charakterbögen in dieser Kampagne gelten (Quelle der
+                Wahrheit ist der Server, z. B. von der SL auf der Seite Guthaben eingestellt). maxSheets = Bögen je
+                Mitglied (0 = keine Abgabe), maxPages = ausgewertete Seiten je Bogen. Fehlt das Feld (ältere Server),
+                gelten 3 Bögen und 20 Seiten wie in 0.4.18; die App nennt dann keine Zahlen.
+              required: [maxSheets, maxPages]
+              properties:
+                maxSheets: { type: integer, minimum: 0, maximum: 50 }
+                maxPages: { type: integer, minimum: 1 }
             allowExternalTranscription:
@@ -3630,2 +3647,7 @@ components:
             null = aus der mitgebrachten Welt.
+        relation:
+          type: [string, "null"]
+          description: |
+            Ab 0.4.19, nur bei source character aus der mitgebrachten Welt: WorldEntryIn.relation unverändert, sonst null.
+            Sichtbar wie der Vorschlag selbst (SL); geht nicht von selbst in den Eintrag.
         entryType: { $ref: "#/components/schemas/EntryType" }
@@ -3946,2 +3968,8 @@ components:
         secret: { type: boolean, description: "Nur SL und Urheberin sollen es wissen" }
+        relation:
+          type: [string, "null"]
+          maxLength: 120
+          description: |
+            Ab 0.4.19, optional: wie der Eintrag zum Charakter steht, z. B. „Schwester von Litha“. Nur Anzeige. Leer oder
+            nur Leerzeichen = null. Eine Änderung zählt wie jede andere Änderung (version steigt, Vorschlag update).
 
diff --git a/scripts/tests/character-sanitize.test.mjs b/scripts/tests/character-sanitize.test.mjs
index 47f2cd4..efefd3b 100644
--- a/scripts/tests/character-sanitize.test.mjs
+++ b/scripts/tests/character-sanitize.test.mjs
@@ -33 +33,11 @@ test('fremde Welt-Einträge fallen weg', () => {
 });
+
+test('Beziehung zum Charakter (0.4.19): kurzer Text bleibt, zu lang oder kein Text fällt weg', () => {
+  const c = sanitizeCharacter({ ...ok, world: [
+    { ...ok.world[0], relation: 'Bruder von Litha' },
+    { ...ok.world[0], id: 'w2', relation: null },
+    { ...ok.world[0], id: 'w3', relation: 'x'.repeat(121) },
+    { ...ok.world[0], id: 'w4', relation: 42 }
+  ] });
+  assert.deepEqual(c.world.map((w) => w.id), ['w1', 'w2']);
+});
