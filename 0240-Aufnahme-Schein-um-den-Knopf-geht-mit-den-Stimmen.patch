-    </div>
+    <p className="rec-quiet" role="status" style={{ margin: 0, textAlign: 'center' }}>
+      {tn(min, 'Das Mikrofon hört seit einer Minute nichts.', 'Das Mikrofon hört seit {n} Minuten nichts.')}
+    </p>
   );
 }
