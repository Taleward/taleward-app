 src/components/Screen.tsx           |  2 +-
 src/i18n/en.ts                      | 11 +++++------
 src/pages/BroughtPage.tsx           |  5 +----
 src/pages/Recording.tsx             | 22 ++++++++++++++++++----
 src/recorder/MicNote.tsx            | 19 ++++---------------
 src/table/GroupPanel.tsx            |  2 +-
 src/theme.css                       | 21 +++++++++++++++++----
 8 files changed, 49 insertions(+), 37 deletions(-)

