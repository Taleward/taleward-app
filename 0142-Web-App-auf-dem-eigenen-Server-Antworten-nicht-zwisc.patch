From 8f726d1a4e8e8d9033606584a44fbc3231a70924 Mon Sep 17 00:00:00 2001
From: "Tinkerworks (Benjamin)"
 <121437138+Tinkerworkss@users.noreply.github.com>
Date: Fri, 16 Oct 2026 23:55:33 +0200
Subject: [PATCH] Web-App auf dem eigenen Server: Antworten nicht
 zwischenspeichern, Kapitel neueste zuerst
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Läuft die Web-App unter derselben Adresse wie der Server (z. B. /app/),
hat der Service Worker auch Antworten der Schnittstelle gespeichert und
danach veraltete Stände gezeigt. Er fasst jetzt nur noch Dateien der
App an; der neue Speichername räumt alte Einträge weg.

Die Liste der Runden kommt vom Server aufsteigend; Chronik, Übersicht
und Vorbereitung rechnen mit der neuesten zuerst. Die App sortiert sie
jetzt selbst.
---
 public/sw.js      | 6 +++++-
 src/api/client.ts | 4 +++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/public/sw.js b/public/sw.js
index 3d672e7..d481373 100644
--- a/public/sw.js
+++ b/public/sw.js
@@ -3,5 +3,5 @@
  * schnell startet. Er fasst NUR Dateien der App selbst an (gleiche Herkunft) – nie Anfragen an Vereinsserver.
  */
-const CACHE = 'taleward-app-v1';
+const CACHE = 'taleward-app-v2'; // v2: alte Fassung hatte auch Server-Antworten gespeichert
 
 self.addEventListener('install', () => self.skipWaiting());
@@ -15,4 +15,8 @@ self.addEventListener('fetch', (e) => {
   if (req.method !== 'GET' || url.origin !== self.location.origin) return; // Server-Anfragen unberührt lassen
   if (url.pathname.includes('/auth/app')) return; // Rückweg der Anmeldung (Ticket in der Adresse): nie speichern
+  // Läuft die App auf dem eigenen Server (z. B. /app/), liegt die Schnittstelle auf derselben Herkunft:
+  // nur Dateien unterhalb der App anfassen, nie die Schnittstelle oder Seiten des Servers
+  const scope = new URL(self.registration.scope).pathname;
+  if (!url.pathname.startsWith(scope) || url.pathname.includes('/api/')) return;
   if (req.mode === 'navigate') {
     // Seite selbst: immer frisch vom Netz, sonst die zuletzt gesehene Fassung
diff --git a/src/api/client.ts b/src/api/client.ts
index 2b8377c..e6aaf79 100644
--- a/src/api/client.ts
+++ b/src/api/client.ts
@@ -373,5 +373,7 @@ function makeApi(conn: () => Connection) {
     request<Member>('POST', `/campaigns/${campaignId}/members/${memberId}/release`),
 
-  sessions: (campaignId: string) => request<SessionSummary[]>('GET', `/campaigns/${campaignId}/sessions`),
+  // Die Schnittstelle legt keine Reihenfolge fest (Server liefern aufsteigend); die App rechnet mit „neueste zuerst“
+  sessions: (campaignId: string) =>
+    request<SessionSummary[]>('GET', `/campaigns/${campaignId}/sessions`).then((list) => [...list].sort((a, b) => b.number - a.number)),
   session: (id: string) => request<Session>('GET', `/sessions/${id}`),
   createSession: (campaignId: string, playedAt: string, attendees: Attendee[], title?: string) =>
