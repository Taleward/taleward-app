- Einladen, Welt (freiwillig), erste Runde aufnehmen; der nächste offene Schritt ist der Hauptknopf
- Titelbild als leiser Link, Tour der SL zeigt zuerst auf diese Karte
- Unbekanntes Spielsystem eines neueren Servers wird wie „Anderes“ angezeigt
---
 src/components/GameSystemFields.tsx |  4 +-
 src/i18n/en.ts                      | 10 ++++-
 src/pages/Overview.tsx              | 60 ++++++++++++++++++-----------
 src/tour/steps.ts                   |  1 +
 4 files changed, 50 insertions(+), 25 deletions(-)

diff --git a/src/components/GameSystemFields.tsx b/src/components/GameSystemFields.tsx
index 0fbedf2..7cef56b 100644
--- a/src/components/GameSystemFields.tsx
+++ b/src/components/GameSystemFields.tsx
@@ -15,5 +15,7 @@ export const GAME_SYSTEMS: { value: GameSystem; label: string }[] = [
 /** Anzeige „Das Schwarze Auge“ bzw. bei „Anderes“ der frei eingetragene Name */
 export function systemLabel(system: GameSystem | null | undefined, systemName: string | null | undefined): string | null {
-  if (system && system !== 'other') return GAME_SYSTEMS.find((s) => s.value === system)!.label;
+  // Unbekanntes System (neuerer Server): wie „Anderes“ behandeln statt abzustürzen
+  const known = system && system !== 'other' ? GAME_SYSTEMS.find((s) => s.value === system) : undefined;
+  if (known) return known.label;
   return systemName?.trim() || null;
 }
