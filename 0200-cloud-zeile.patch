diff --git a/src/components/CloudNotice.tsx b/src/components/CloudNotice.tsx
index a7a289d..1978781 100644
--- a/src/components/CloudNotice.tsx
+++ b/src/components/CloudNotice.tsx
@@ -1,3 +1,2 @@
-import { IconInfo } from './Icons';
 import { useEffect, useState } from 'react';
 import { api } from '../api/client';
@@ -50,17 +49,2 @@ export function cloudUse(info: ServerInfo | null, campaign: Campaign, long = fal
 }
 
-/** Kasten auf der Übersicht: klar zeigen, ob Stimmen oder Text den Verein verlassen */
-export function CloudNotice({ info, campaign, onOpen }: { info: ServerInfo | null; campaign: Campaign; onOpen: () => void }) {
-  const { transcription, summary } = cloudUse(info, campaign);
-  if (!transcription && !summary) return null;
-  // Eine Zeile statt eigener Karte: Sichtbar für alle bleibt sie, die Einzelheiten stehen
-  // unter „Was mit deinen Daten passiert“.
-  const providers = [...new Set([transcription?.provider, summary?.provider].filter((x): x is string => !!x))].join(', ');
-  return (
-    <button type="button" className="notice cloud-line" onClick={onOpen}>
-      <span aria-hidden="true" style={{ flexShrink: 0, color: 'var(--ink-faint)' }}><IconInfo /></span>
-      <span style={{ flex: 1 }}>{t('Cloud aktiv · {provider}', { provider: providers })}</span>
-      <span aria-hidden="true" style={{ color: 'var(--ink-faint)' }}>›</span>
-    </button>
-  );
-}
diff --git a/src/components/DataSummary.tsx b/src/components/DataSummary.tsx
index b694082..db7d30e 100644
--- a/src/components/DataSummary.tsx
+++ b/src/components/DataSummary.tsx
@@ -78,13 +78,2 @@ export function DataSummary({ campaign, info, gm }: { campaign: Campaign; info:
 }
 
-/** Aufklappen und hinscrollen, z. B. von der Zeile „Cloud aktiv“ */
-export function openDataSummary() {
-  const d = document.getElementById('data-summary') as HTMLDetailsElement | null;
-  if (!d) return;
-  // Liegt in „Kampagne verwalten“: die Karte mit aufklappen
-  const outer = d.parentElement?.closest('details');
-  if (outer) outer.open = true;
-  d.open = true;
-  d.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
-  d.querySelector('summary')?.focus();
-}
