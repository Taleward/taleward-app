diff --git a/src/display/scale.ts b/src/display/scale.ts
new file mode 100644
index 0000000..5ae0e01
--- /dev/null
+++ b/src/display/scale.ts
@@ -0,0 +1,15 @@
+/**
+ * Schriftgröße des Handys → Faktor für die Oberfläche (CSS-Variable --ts). Ohne Laufzeit-Importe, damit es sich testen
+ * lässt (scripts/tests/text-scale.test.mjs).
+ *
+ * Android bietet je nach Gerät etwa 0,85 bis 2,0. Nach oben bei 1,6 begrenzt: Darüber passen Knöpfe, Kopfzeile und
+ * SL-Schirm auf einem Handy nicht mehr sinnvoll nebeneinander. Kleiner als 0,85 gibt es nicht.
+ */
+export const MIN_SCALE = 0.85;
+export const MAX_SCALE = 1.6;
+
+export function clampScale(value: unknown): number {
+  const n = typeof value === 'number' ? value : Number(value);
+  if (!Number.isFinite(n) || n <= 0) return 1;
+  return Math.round(Math.min(MAX_SCALE, Math.max(MIN_SCALE, n)) * 100) / 100;
+}
diff --git a/src/display/textScale.ts b/src/display/textScale.ts
new file mode 100644
index 0000000..042b0d2
--- /dev/null
+++ b/src/display/textScale.ts
@@ -0,0 +1,30 @@
+import { Capacitor, registerPlugin } from '@capacitor/core';
+import { clampScale } from './scale';
+
+/*
+ * Schriftgröße des Handys in der Android-App übernehmen (Benjamin 15.10.). Im Browser regelt der Browser selbst
+ * (Zoom), dort bleibt --ts bei 1. Ältere Android-Fassungen ohne den nativen Teil: ebenfalls 1.
+ */
+interface TextScalePlugin {
+  get(): Promise<{ scale: number }>;
+}
+
+const TextScale = registerPlugin<TextScalePlugin>('TextScale');
+
+async function apply(): Promise<void> {
+  try {
+    const { scale } = await TextScale.get();
+    document.documentElement.style.setProperty('--ts', String(clampScale(scale)));
+  } catch {
+    /* ohne nativen Teil: normale Größe */
+  }
+}
+
+/** Beim Start und jedes Mal, wenn die App wieder sichtbar wird (die Einstellung kann sich dazwischen ändern) */
+export function followSystemTextScale(): void {
+  if (!Capacitor.isNativePlatform()) return;
+  apply();
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') apply();
+  });
+}
