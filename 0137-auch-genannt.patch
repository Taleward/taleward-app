diff --git a/scripts/tests/aliases.test.mjs b/scripts/tests/aliases.test.mjs
new file mode 100644
index 0000000..bbe07a6
--- /dev/null
+++ b/scripts/tests/aliases.test.mjs
@@ -0,0 +1,21 @@
+// „Auch genannt“: Eingabe bereinigen wie der Server, Schreibweise beim Ergänzen
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { addsAlias, parseAliases, MAX_ALIASES } from '../../src/bible/aliases.ts';
+
+test('Komma, Semikolon und Zeilen trennen; Name und Doppelte fallen weg', () => {
+  assert.deepEqual(parseAliases('Tarvok, der Alte; tarvok\nTharvok ,  ', 'Tharvok'), ['Tarvok', 'der Alte']);
+});
+
+test('Grenzen: höchstens zehn, je höchstens 40 Zeichen', () => {
+  const many = Array.from({ length: 14 }, (_, i) => `Name${i}`).join(',');
+  assert.equal(parseAliases(many, 'X').length, MAX_ALIASES);
+  assert.equal(parseAliases('a'.repeat(60), 'X')[0].length, 40);
+});
+
+test('Schreibweise kommt nur dazu, wenn sie neu ist', () => {
+  assert.equal(addsAlias('Tarvok', 'Tharvok', []), true);
+  assert.equal(addsAlias('tharvok', 'Tharvok', []), false);
+  assert.equal(addsAlias('Tarvok', 'Tharvok', ['TARVOK']), false);
+  assert.equal(addsAlias('  ', 'Tharvok', []), false);
+});
diff --git a/src/bible/aliases.ts b/src/bible/aliases.ts
new file mode 100644
index 0000000..0bf3d9d
--- /dev/null
+++ b/src/bible/aliases.ts
@@ -0,0 +1,32 @@
+/**
+ * „Auch genannt“ (ab Schnittstelle 0.4.21): weitere Namen eines Bibeleintrags.
+ * Ohne Laufzeit-Importe, damit es sich testen lässt (scripts/tests/aliases.test.mjs).
+ */
+export const MAX_ALIASES = 10;
+export const MAX_ALIAS_LENGTH = 40;
+
+const key = (s: string) => s.trim().toLocaleLowerCase('de');
+
+/** Eingabe „Tarvok, der Alte; Tharv“ → bereinigte Liste wie der Server sie speichert (ohne den Namen selbst, ohne Doppelte) */
+export function parseAliases(input: string, name: string): string[] {
+  const out: string[] = [];
+  const seen = new Set([key(name)]);
+  for (const raw of input.split(/[,;\n]/)) {
+    const a = raw.trim().replace(/\s+/g, ' ').slice(0, MAX_ALIAS_LENGTH).trim();
+    if (!a || seen.has(key(a))) continue;
+    seen.add(key(a));
+    out.push(a);
+    if (out.length === MAX_ALIASES) break;
+  }
+  return out;
+}
+
+export function aliasesText(aliases: string[] | undefined): string {
+  return (aliases ?? []).join(', ');
+}
+
+/** Kommt die Schreibweise eines Vorschlags beim Ergänzen zu „Auch genannt“? (nicht, wenn sie schon Name oder Alias ist) */
+export function addsAlias(spelling: string, name: string, aliases: string[] | undefined): boolean {
+  const k = key(spelling);
+  return !!k && k !== key(name) && !(aliases ?? []).some((a) => key(a) === k);
+}
