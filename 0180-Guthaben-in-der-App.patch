diff --git a/src/billing/CreditWaitNote.tsx b/src/billing/CreditWaitNote.tsx
new file mode 100644
index 0000000..2d63f58
--- /dev/null
+++ b/src/billing/CreditWaitNote.tsx
@@ -0,0 +1,95 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { api } from '../api/client';
+import { currentConnection } from '../api/connections';
+import type { CreditWait } from '../api/types';
+import { confirmDialog } from '../components/confirm';
+import { IconInfo } from '../components/Icons';
+import { ErrorBox } from '../components/Screen';
+import { getLang, t } from '../i18n';
+import { DIST } from '../update/updater';
+import { canApprove, euro, waitReason } from './rules';
+
+/** Betrag in der Sprache der App */
+export const eur = (cents: number) => euro(cents, getLang());
+
+/**
+ * Warum ein Auftrag wegen des Guthabens wartet (Schnittstelle 0.4.25). Den Satz formuliert die App selbst: in der
+ * Store-Fassung ohne Link und ohne Knopf zum Aufladen, sonst mit Weg zur Seite „Guthaben“ in der App.
+ * Betrag, „Verarbeiten“ und der Weg zum Guthaben gibt es nur, wenn der Server die Kennungen mitschickt (zahlende SL).
+ */
+export function CreditWaitNote({ wait, onApproved }: { wait: CreditWait | null | undefined; onApproved?: () => void }) {
+  const [busy, setBusy] = useState(false);
+  const [done, setDone] = useState(false);
+  const [error, setError] = useState<unknown>(null);
+  if (!wait || done) return null;
+  const reason = waitReason(wait.reason);
+  const mine = !!wait.creditId;
+  const amount = wait.estimateCents != null ? eur(wait.estimateCents) : null;
+  const store = DIST === 'store';
+  const creditPage = mine ? `/v/${currentConnection().id}/guthaben` : null;
+
+  let text: string;
+  switch (reason) {
+    case 'approval':
+      text = mine
+        ? (amount ? t('Kostet voraussichtlich {amount}. Die Verarbeitung startet, sobald du sie freigibst.', { amount }) : t('Die Verarbeitung startet, sobald du sie freigibst.'))
+        : t('Die Verarbeitung wartet auf die Freigabe der Spielleitung, die für die Kampagne zahlt.');
+      break;
+    case 'empty':
+      text = mine
+        ? (store ? t('Kein Guthaben, die Verarbeitung wartet. Du kannst es auf der Seite deines Servers aufladen.') : t('Kein Guthaben, die Verarbeitung wartet. Danach startet sie von selbst.'))
+        : t('Das Guthaben der Spielleitung, die für die Kampagne zahlt, ist aufgebraucht. Die Verarbeitung wartet.');
+      break;
+    case 'too_low':
+      text = mine
+        ? (store
+          ? t('Das Guthaben reicht voraussichtlich nicht ({amount}). Du kannst es auf der Seite deines Servers aufladen.', { amount: amount ?? '?' })
+          : t('Das Guthaben reicht voraussichtlich nicht ({amount}). Danach startet die Verarbeitung von selbst.', { amount: amount ?? '?' }))
+        : t('Das Guthaben der Spielleitung, die für die Kampagne zahlt, reicht voraussichtlich nicht. Die Verarbeitung wartet.');
+      break;
+    case 'no_payer':
+      text = t('Für diese Kampagne zahlt gerade niemand. Unter „Kampagne verwalten“ kann eine Spielleitung die Zahlung übernehmen.');
+      break;
+    case 'pot':
+      text = t('Das Guthaben der Organisation reicht gerade nicht oder wartet auf die Verwaltung. Die Verarbeitung startet danach von selbst.');
+      break;
+    default:
+      text = t('Die Verarbeitung wartet auf das Guthaben.');
+  }
+
+  const approve = async () => {
+    if (!wait.creditId || !wait.jobId) return;
+    const q = amount
+      ? t('Verarbeiten? Das kostet voraussichtlich {amount} aus deinem Guthaben.', { amount })
+      : t('Verarbeiten? Die Kosten gehen von deinem Guthaben ab.');
+    if (!(await confirmDialog(q, { confirmLabel: t('Verarbeiten') }))) return;
+    setBusy(true);
+    setError(null);
+    try {
+      await api.approveCreditJob(wait.creditId, wait.jobId);
+      setDone(true);
+      onApproved?.();
+    } catch (e) {
+      setError(e);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="notice" role="status" style={{ flexDirection: 'column', alignItems: 'stretch', gap: 8 }}>
+      <div className="row" style={{ gap: 8, alignItems: 'flex-start' }}>
+        <span style={{ flexShrink: 0, color: 'var(--ink-muted)' }}><IconInfo /></span>
+        <span>{text}</span>
+      </div>
+      <ErrorBox error={error} />
+      {(canApprove(wait) || (creditPage && reason !== 'approval')) && (
+        <div className="row wrap" style={{ gap: 8 }}>
+          {canApprove(wait) && <button type="button" className="btn small" disabled={busy} onClick={approve}>{t('Verarbeiten')}</button>}
+          {creditPage && reason !== 'approval' && <Link className="btn small outline" to={creditPage}>{t('Guthaben ansehen')}</Link>}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/billing/PayerSection.tsx b/src/billing/PayerSection.tsx
new file mode 100644
index 0000000..a42e228
--- /dev/null
+++ b/src/billing/PayerSection.tsx
@@ -0,0 +1,82 @@
+import { useState } from 'react';
+import { api } from '../api/client';
+import { currentConnection } from '../api/connections';
+import type { Campaign, Member } from '../api/types';
+import { isDeletedMember } from '../api/types';
+import { confirmDialog } from '../components/confirm';
+import { ErrorBox } from '../components/Screen';
+import { t } from '../i18n';
+
+/**
+ * Wer zahlt für die Kampagne (Schnittstelle 0.4.25, nur SL und nur mit Guthaben): Zahlung an eine andere SL abgeben
+ * oder übernehmen. Unter „Kampagne verwalten“.
+ */
+export function PayerSection({ campaign, me, onChanged }: { campaign: Campaign; me: Member; onChanged: () => void }) {
+  const billing = campaign.billing!;
+  const otherGms = campaign.members.filter((m) => m.role === 'gm' && m.id !== me.id && m.userId && !m.leftAt && !isDeletedMember(m));
+  const [target, setTarget] = useState(otherGms[0]?.id ?? '');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<unknown>(null);
+  const name = (id: string | null | undefined) => campaign.members.find((m) => m.id === id)?.displayName ?? t('eine andere Spielleitung');
+  const server = currentConnection().name;
+
+  const run = async (action: () => Promise<unknown>) => {
+    setBusy(true);
+    setError(null);
+    try {
+      await action();
+      onChanged();
+    } catch (e) {
+      setError(e);
+    } finally {
+      setBusy(false);
+    }
+  };
+  const accept = async () => {
+    if (await confirmDialog(t('Zahlung für „{campaign}“ auf „{server}“ übernehmen? Ab dann gehen die Kosten der Verarbeitung von deinem Guthaben ab.', { campaign: campaign.title, server }), { confirmLabel: t('Übernehmen') })) {
+      run(() => api.acceptPayment(campaign.id));
+    }
+  };
+  const offer = async () => {
+    if (await confirmDialog(t('Zahlung an {name} abgeben? Bis {name} übernimmt, zahlst du weiter.', { name: name(target) }), { confirmLabel: t('Anbieten') })) {
+      run(() => api.offerPayment(campaign.id, target));
+    }
+  };
+
+  let line: string;
+  if (billing.paidBy === 'organization') line = t('Bezahlt wird aus dem Guthaben der Organisation.');
+  else if (billing.paidBy === 'nobody') line = t('Gerade zahlt niemand für diese Kampagne. Neue Verarbeitungen warten, bis eine Spielleitung übernimmt.');
+  else if (billing.isMe) line = t('Die Kosten der Verarbeitung gehen von deinem Guthaben ab.');
+  else line = t('Die Kosten der Verarbeitung gehen vom Guthaben von {name} ab.', { name: name(billing.payerMemberId) });
+
+  return (
+    <>
+      <span className="overline" style={{ marginTop: 6 }}>{t('Wer zahlt')}</span>
+      <span className="small">{line}</span>
+      <ErrorBox error={error} />
+      {(billing.paidBy === 'nobody' || (billing.paidBy === 'gm' && !billing.isMe && billing.offeredToMemberId === me.id)) && (
+        <>
+          {billing.paidBy === 'gm' && <span className="small">{t('{name} möchte dir die Zahlung übergeben.', { name: name(billing.payerMemberId) })}</span>}
+          <button type="button" className="btn outline" disabled={busy} onClick={accept}>{t('Zahlung übernehmen')}</button>
+        </>
+      )}
+      {billing.paidBy === 'gm' && billing.isMe && billing.offeredToMemberId && (
+        <div className="row wrap" style={{ gap: 8, alignItems: 'center' }}>
+          <span className="small" style={{ flex: '1 1 160px' }}>{t('Angeboten an {name}, noch nicht übernommen.', { name: name(billing.offeredToMemberId) })}</span>
+          <button type="button" className="btn small outline" disabled={busy} onClick={() => run(() => api.offerPayment(campaign.id, null))}>{t('Angebot zurücknehmen')}</button>
+        </div>
+      )}
+      {billing.paidBy === 'gm' && billing.isMe && !billing.offeredToMemberId && otherGms.length > 0 && (
+        <div className="row wrap" style={{ gap: 8, alignItems: 'flex-end' }}>
+          <div className="field" style={{ flex: '1 1 160px', margin: 0 }}>
+            <label htmlFor="payer-target" className="small">{t('Zahlung abgeben an')}</label>
+            <select id="payer-target" value={target} onChange={(e) => setTarget(e.target.value)}>
+              {otherGms.map((m) => <option key={m.id} value={m.id}>{m.displayName}</option>)}
+            </select>
+          </div>
+          <button type="button" className="btn small outline" disabled={busy || !target} onClick={offer}>{t('Anbieten')}</button>
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/src/billing/rules.ts b/src/billing/rules.ts
new file mode 100644
index 0000000..3afaf16
--- /dev/null
+++ b/src/billing/rules.ts
@@ -0,0 +1,68 @@
+/*
+ * Guthaben in der App (Schnittstelle 0.4.25) – Regeln ohne Laufzeit-Importe (Test: scripts/tests/billing.test.mjs).
+ *
+ * Bezahlt wird nie in der App. Store-Fassung: kein Link, kein Knopf und keine Preise zum Aufladen, Gutscheine vorerst
+ * auch nicht (Prüfung der Store-Regeln vor dem Scharfschalten). Fassung von der Website und Web-App: Knopf „Guthaben
+ * aufladen“ öffnet die Aufladeseite des Servers im Browser – nur wenn sie auf demselben Server liegt wie die Verbindung.
+ */
+
+export type Dist = 'apk' | 'store' | 'web';
+
+export interface BillingInfo {
+  billing?: { mode?: string; currency?: string; topUpUrl?: string | null } | null;
+}
+
+/** Rechnet der Server mit Guthaben ab? Fehlt die Angabe (ältere Server) oder ist sie null: nein */
+export function billingOn(info: BillingInfo | null | undefined): boolean {
+  return !!info?.billing && (info.billing.mode === 'credit' || info.billing.mode === 'pot');
+}
+
+function origin(url: string): string | null {
+  try {
+    const u = new URL(url);
+    return u.protocol === 'https:' || u.protocol === 'http:' ? u.origin : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Adresse für „Guthaben aufladen“ oder null. Nie in der Store-Fassung, nur über https (http nur, wenn auch die
+ * Verbindung http ist, z. B. im Heimnetz) und nur auf demselben Server wie die Verbindung.
+ */
+export function topUpUrl(info: BillingInfo | null | undefined, connBaseUrl: string, dist: Dist): string | null {
+  if (dist === 'store' || !billingOn(info)) return null;
+  const url = info?.billing?.topUpUrl;
+  if (!url) return null;
+  const a = origin(url);
+  const b = origin(connBaseUrl);
+  if (!a || !b || a !== b) return null;
+  return url;
+}
+
+/** Gutschein einlösen: vorerst nicht in der Store-Fassung */
+export const vouchersAllowed = (dist: Dist): boolean => dist !== 'store';
+
+export type WaitReason = 'approval' | 'empty' | 'too_low' | 'no_payer' | 'pot' | 'other';
+
+/** Bekannte Wartegründe; unbekannte (neuere Server) als „other“ */
+export function waitReason(reason: string | null | undefined): WaitReason {
+  return reason === 'approval' || reason === 'empty' || reason === 'too_low' || reason === 'no_payer' || reason === 'pot' ? reason : 'other';
+}
+
+/** Darf ich hier „Verarbeiten“ tippen? Nur mit Kennungen (die gibt es nur für Berechtigte) und nicht beim Topf */
+export function canApprove(wait: { reason: string; creditId?: string | null; jobId?: string | null } | null | undefined): boolean {
+  return !!wait && waitReason(wait.reason) === 'approval' && !!wait.creditId && !!wait.jobId;
+}
+
+/** Betrag in Euro, z. B. „12,40 €“ bzw. „€12.40“; negative mit Minuszeichen */
+export function euro(cents: number, lang: 'de' | 'en'): string {
+  return new Intl.NumberFormat(lang === 'de' ? 'de-DE' : 'en-IE', { style: 'currency', currency: 'EUR' }).format(cents / 100);
+}
+
+/** Eingabe „2“, „2,50“ oder „2.50“ in Cent; ungültig → null */
+export function parseEuro(text: string): number | null {
+  const s = text.trim().replace(/\s|€/g, '').replace(',', '.');
+  if (!/^\d{1,4}(\.\d{1,2})?$/.test(s)) return null;
+  return Math.round(Number(s) * 100);
+}
diff --git a/src/components/CampaignSettings.tsx b/src/components/CampaignSettings.tsx
new file mode 100644
index 0000000..6e945e6
--- /dev/null
+++ b/src/components/CampaignSettings.tsx
@@ -0,0 +1,158 @@
+import { useCallback, useEffect, useState } from 'react';
+import { api, fetchServerInfo, isApiError } from '../api/client';
+import { apiAtLeast, type Connection } from '../api/connections';
+import type { Campaign, CampaignSettings, CampaignSettingsIn, CampaignSettingsLogEntry, ServerInfo, SettingField } from '../api/types';
+import { providerLabel } from './CloudNotice';
+import { isDeletedMember } from '../api/types';
+import { formatDate } from './format';
+import { t, tk } from '../i18n';
+
+/*
+ * Kampagnen-Einstellungen an einem Ort (Schnittstelle 0.4.25): Lesen und Ändern über …/settings mit Fassungsnummer,
+ * damit zwei Geräte sich nicht still überschreiben; Vorgaben des Betreibers (locks); Protokoll. Ältere Server: wie
+ * bisher über PATCH /campaigns/{id}.
+ */
+
+export interface SettingsState {
+  values: Record<SettingField, boolean>;
+  /** null = frei; operator = vom Betreiber festgelegt; unavailable = gibt es auf diesem Server nicht */
+  lock: (field: SettingField) => 'operator' | 'unavailable' | null;
+  change: (field: SettingField, value: boolean) => Promise<void>;
+  /** Jemand anderes hat inzwischen geändert – der neue Stand ist geladen */
+  conflict: boolean;
+  /** Protokoll vorhanden (ab 0.4.25) */
+  hasLog: boolean;
+}
+
+export function useCampaignSettings(campaign: Campaign, onChanged: () => void): SettingsState {
+  const modern = apiAtLeast('0.4.25');
+  const [settings, setSettings] = useState<CampaignSettings | null>(null);
+  const [conflict, setConflict] = useState(false);
+
+  useEffect(() => {
+    if (!modern) return;
+    api.campaignSettings(campaign.id).then(setSettings).catch(() => setSettings(null));
+  }, [campaign.id, campaign.settingsVersion, modern]);
+
+  const values: Record<SettingField, boolean> = settings
+    ? { allowCloudSummary: settings.allowCloudSummary, allowExternalTranscription: settings.allowExternalTranscription, allowCharacterAnalysis: settings.allowCharacterAnalysis }
+    : { allowCloudSummary: !!campaign.allowCloudSummary, allowExternalTranscription: !!campaign.allowExternalTranscription, allowCharacterAnalysis: !!campaign.allowCharacterAnalysis };
+
+  const lock = (field: SettingField) => {
+    const l = settings?.locks.find((x) => x.field === field);
+    if (!l) return null;
+    return l.reason === 'unavailable' ? 'unavailable' : 'operator';
+  };
+
+  const change = useCallback(async (field: SettingField, value: boolean) => {
+    setConflict(false);
+    if (!modern || !settings) {
+      await api.updateCampaign(campaign.id, { [field]: value });
+      onChanged();
+      return;
+    }
+    try {
+      setSettings(await api.updateCampaignSettings(campaign.id, settings.version, { [field]: value }));
+      onChanged();
+    } catch (e) {
+      if (isApiError(e, 'settings_conflict')) {
+        const current = (e.details as { current?: CampaignSettings } | undefined)?.current;
+        if (current) setSettings(current);
+        else api.campaignSettings(campaign.id).then(setSettings).catch(() => undefined);
+        setConflict(true);
+        onChanged();
+        return;
+      }
+      throw e;
+    }
+  }, [campaign.id, modern, settings, onChanged]);
+
+  return { values, lock, change, conflict, hasLog: modern && !!settings };
+}
+
+const FIELDS: Record<string, string> = {
+  allowCloudSummary: tk('Zusammenfassung über die Cloud'),
+  allowExternalTranscription: tk('Transkription über die Cloud'),
+  allowCharacterAnalysis: tk('Charakterbögen auswerten')
+};
+
+/** Wer hat wann was geändert (nur SL, ab 0.4.25) */
+export function SettingsLog({ campaign }: { campaign: Campaign }) {
+  const [log, setLog] = useState<CampaignSettingsLogEntry[] | null>(null);
+  const [open, setOpen] = useState(false);
+  useEffect(() => {
+    if (open && !log) api.campaignSettingsLog(campaign.id).then(setLog).catch(() => setLog([]));
+  }, [open, log, campaign.id]);
+  const who = (e: CampaignSettingsLogEntry) => {
+    if (e.byOperator) return t('Betreiber');
+    const m = campaign.members.find((x) => x.id === e.byMemberId);
+    return m && !isDeletedMember(m) ? m.displayName : t('Unbekannt');
+  };
+  const value = (v: boolean | number | null) => (v === true ? t('an') : v === false ? t('aus') : v === null ? '–' : String(v));
+  return (
+    <details className="more" onToggle={(e) => setOpen((e.target as HTMLDetailsElement).open)}>
+      <summary className="small">{t('Änderungen der Einstellungen')}</summary>
+      {open && !log && <span className="muted small">{t('Wird geladen …')}</span>}
+      {log && log.length === 0 && <span className="muted small">{t('Noch nichts geändert.')}</span>}
+      {log && log.length > 0 && (
+        <ul className="small" style={{ margin: '6px 0 0', paddingLeft: 18 }}>
+          {log.map((e, i) => (
+            <li key={i}>
+              {formatDate(e.at)} · {who(e)}: {FIELDS[e.field] ? t(FIELDS[e.field]) : e.field} {value(e.oldValue)} → {value(e.newValue)}
+            </li>
+          ))}
+        </ul>
+      )}
+    </details>
+  );
+}
+
+/** Hinweis bei Vorgabe des Betreibers */
+export function LockNote({ lock }: { lock: 'operator' | 'unavailable' | null }) {
+  if (lock !== 'operator') return null;
+  return <span className="muted small">{t('Vom Betreiber des Servers festgelegt.')}</span>;
+}
+
+/**
+ * Drei kurze Fragen beim Anlegen (ab 0.4.25), eingeklappt und freiwillig. Geschickt wird nur, was die SL ändert;
+ * sonst gilt die Voreinstellung des Servers (bei „Nur Cloud“ ist die Cloud dort schon an).
+ */
+export function StartSettings({ conn, value, onChange }: {
+  conn: Connection; value: CampaignSettingsIn; onChange: (v: CampaignSettingsIn) => void;
+}) {
+  const [info, setInfo] = useState<ServerInfo | null>(null);
+  useEffect(() => {
+    setInfo(null);
+    fetchServerInfo(conn.baseUrl).then(setInfo).catch(() => setInfo(null));
+  }, [conn.baseUrl]);
+  if (!apiAtLeast('0.4.25', conn) || !info) return null;
+  const cloudOnly = info.externalTranscriptionMode === 'primary';
+  const shown = (field: SettingField, fallback: boolean) => value[field] ?? fallback;
+  const set = (field: SettingField, v: boolean) => onChange({ ...value, [field]: v });
+  const summary = providerLabel(info.cloudSummary, info.cloudSummaryInfo);
+  const external = providerLabel(info.externalTranscription, info.externalTranscriptionInfo);
+  return (
+    <details className="more">
+      <summary>{t('Einstellungen (freiwillig, später änderbar)')}</summary>
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 8, marginTop: 8 }}>
+        {summary && (
+          <label className="check" style={{ alignItems: 'flex-start' }}>
+            <input type="checkbox" checked={shown('allowCloudSummary', cloudOnly)} onChange={(e) => set('allowCloudSummary', e.target.checked)} style={{ marginTop: 3, flexShrink: 0 }} />
+            <span>{t('Kapitel über {provider} schreiben lassen', { provider: summary })}</span>
+          </label>
+        )}
+        {external && (
+          <label className="check" style={{ alignItems: 'flex-start' }}>
+            <input type="checkbox" checked={shown('allowExternalTranscription', cloudOnly)} onChange={(e) => set('allowExternalTranscription', e.target.checked)} style={{ marginTop: 3, flexShrink: 0 }} />
+            <span>{cloudOnly ? t('Abschrift über {provider}', { provider: external }) : t('Abschrift über {provider} als Ausweichlösung', { provider: external })}</span>
+          </label>
+        )}
+        <label className="check" style={{ alignItems: 'flex-start' }}>
+          <input type="checkbox" checked={shown('allowCharacterAnalysis', false)} onChange={(e) => set('allowCharacterAnalysis', e.target.checked)} style={{ marginTop: 3, flexShrink: 0 }} />
+          <span>{t('Charakterbögen und Hintergründe auswerten lassen (du stimmst jeder Auswertung zu)')}</span>
+        </label>
+        {(summary || external) && <span className="muted small">{t('Was in die Cloud geht, sehen alle am Tisch. Sag es vorher in der Runde.')}</span>}
+      </div>
+    </details>
+  );
+}
